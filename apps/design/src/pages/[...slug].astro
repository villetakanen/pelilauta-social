---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Book from '../layouts/Book.astro';
import { GROUPS, type GroupId } from '../lib/books';

/**
 * Every book is served from its collection: the collection id is the first URL
 * segment and the entry id the rest, so `color` in `tokens` stays at
 * /tokens/color.
 */
export async function getStaticPaths() {
  const groups = await Promise.all(
    GROUPS.map(async ({ id }) => {
      const entries = await getCollection(id);
      return entries.map((entry: CollectionEntry<GroupId>) => ({
        params: { slug: `${id}/${entry.id}` },
        props: { entry, group: id },
      }));
    }),
  );

  return groups.flat();
}

interface Props {
  entry: CollectionEntry<GroupId>;
  group: GroupId;
}

const { entry, group } = Astro.props as Props;
const { Content } = await render(entry);
---

<Book
  title={entry.data.title}
  description={entry.data.description}
  group={group}
  prose
>
  <Content />
  <Fragment slot="footer-note">
    <span>Source: <code>apps/design</code></span>
  </Fragment>
</Book>
