---
/**
 * Book.astro — the shared document shell for every design-system book.
 *
 * Renders <html>, <head>, the skip link, the application bar, the navigation
 * and the footer, and a book's <h1> from its frontmatter title.
 */
import CnAppBar from '@design-system/components/CnAppBar.astro';
import CnPoster from '@design-system/components/CnPoster.astro';
import Icon from '@design-system/components/Icon.svelte';
import '@design-system/styles/ds.css';
// Prototype-age scaffolding: the index page's editorial vocabulary, and the table
// and link rules no design-system stylesheet owns yet.
import '@design-system/styles/docs.css';
import DocsNav from '../components/DocsNav.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { groupLabel, runtimeLabel } from '../lib/books';

interface Props {
  title: string;
  /**
   * A book: the shell renders its h1 from the frontmatter title and groups the body
   * in an <article>, which the design system's content container then lays out. The
   * shell still states no measure, rhythm or type of its own — it opts the page into
   * the container and the design system decides the rest.
   *
   * The index page is the one page this is off for: it stacks content containers of
   * its own, and a prose article around them would host them a second time.
   */
  prose?: boolean;
  description: string;
  /** Collection id of the current book, absent on the index page. */
  group?: string;
  /**
   * Artwork for a poster behind this book. The shell mounts it as a direct
   * child of <body>, which is the only placement CnPoster supports, and cedes
   * its own chrome the way an application shell cedes the app bar and the rail.
   * The book column takes no ground plane: an opaque page over the artwork
   * would leave a poster with nothing to show, which is the whole point of the
   * one book that mounts one.
   */
  poster?: string;
  /**
   * What an application must do to make this component work in the browser.
   * Only component books declare it, so its absence keeps the subtitle off
   * every other page without a check on the group. It renders in the design
   * system's caption step; the shell states no type of its own.
   */
  runtime?: string;
}

const {
  title,
  description,
  group,
  poster,
  runtime,
  prose = false,
} = Astro.props;
const context = group ? groupLabel(group) : 'Index';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    <title>{title} / Pelilauta Design System</title>
    <ThemeScript />
  </head>
  <body>
    {poster && <CnPoster src={poster} />}

    <a class="skip-link" href="#content">Skip to content</a>

    <div class="shell">
      <div class="chrome">
        <CnAppBar title={context} shortTitle={context}>
        <ThemeSwitch />
        <!--
          No JavaScript: the drawer is a CSS-only disclosure, so its trigger
          stays a checkbox and a bound label rather than a button. `.chrome-action`
          marks it as one in intent — it stands beside the theme switch as the
          bar's other action — even though the design system's chrome-actions.css
          only styles a native button or anchor; the compact, icon-only look
          below is this shell's own replica of that geometry.
        -->
        <input
          class="nav-toggle"
          id="nav-toggle"
          type="checkbox"
          aria-label="Show the book index"
        />
        <label class="chrome-action nav-toggle-label" for="nav-toggle">
          <Icon noun="dots" decorative />
          <span class="nav-toggle-open">Browse</span>
          <span class="nav-toggle-close">Close</span>
        </label>
        </CnAppBar>
      </div>

      <DocsNav />

      <main class="book app-main" id="content">
        {prose ? (
          <article class="content-prose">
            <h1>{title}</h1>
            {runtime && <p class="text-subtitle">{runtimeLabel(runtime)}</p>}
            <p class="text-small text-low">{description}</p>
            <slot />
          </article>
        ) : (
          <slot />
        )}
      </main>
    </div>

    <footer class="site-footer">
      <a href="/">Index</a>
      <slot name="footer-note" />
    </footer>

    <style>
      .skip-link {
        position: fixed;
        z-index: 3;
        inset-block-start: 0;
        inset-inline-start: 50%;
        translate: -50% -110%;
        padding: 0.7rem 1.2rem;
        color: var(--cn-text-high);
        background: var(--cn-surface-1);
        border: 1px solid var(--cn-border);
        border-block-start: 0;
        font-size: 0.8rem;
        transition: translate 0.15s ease-out;
      }
      .skip-link:focus-visible {
        translate: -50% 0;
        outline: 2px solid var(--cn-focus-ring);
        outline-offset: -4px;
      }

      /* Editorial index column beside the book, collapsing under 60rem. */
      .shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas: 'bar' 'nav' 'book';
      }
      .book { grid-area: book; }

      /*
       * A stand-in for the application chrome container, which has no spec
       * yet: one fixed layer holding the bar, with the book ceding its depth.
       * The bar states no placement, so nothing here fights it.
       */
      .chrome {
        position: fixed;
        z-index: 2;
        inset-block-start: 0;
        inset-inline: 0;
      }
      /*
       * The veil (CnAppBar.astro's `::before`) is invisible at rest, but nothing
       * in the component clears its pointer events — and it stands twice the
       * bar's own depth, so it reaches over whatever content starts right below
       * the bar. Decorative chrome should never steal a click or a hover from
       * the content it fades over; the shell states that here because the veil
       * is the component's own paint, not a target it exposes.
       */
      :global(.cn-app-bar)::before {
        pointer-events: none;
      }
      /* Placement is the shell's concern; the switch styles its own contents. */
      :global(.cn-app-bar .actions) > :global(.cn-theme-switch-scope) {
        flex: none;
      }

      /* Visually hidden but focusable: `hidden` would remove the only
         keyboard route into the drawer. */
      .nav-toggle {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        margin: 0;
        padding: 0;
        border: 0;
        clip-path: inset(50%);
        overflow: hidden;
        white-space: nowrap;
      }
      /*
       * The bar shows icons only, so its other action — the drawer trigger —
       * matches: a compact target the same size as a chrome action's,
       * centred icon, transparent state surface. Not `.chrome-action` itself
       * (chrome-actions.css styles only a native button or anchor), but a
       * label bound to a checkbox needs no script to keep working, so this
       * is a local replica of that geometry rather than the real class.
       */
      .nav-toggle-label {
        position: relative;
        isolation: isolate;
        display: inline-flex;
        flex: none;
        align-items: center;
        justify-content: center;
        inline-size: calc(var(--cn-grid) * 7);
        block-size: calc(var(--cn-grid) * 7);
        color: inherit;
        cursor: pointer;
      }
      .nav-toggle-label::before {
        content: '';
        position: absolute;
        z-index: -1;
        inset-block-start: 50%;
        inset-inline-start: 50%;
        translate: -50% -50%;
        inline-size: calc(var(--cn-grid) * 6);
        block-size: calc(var(--cn-grid) * 6);
        border-radius: calc(var(--cn-grid) * 3);
        background-color: transparent;
        transition: background-color var(--cn-duration-ui) var(--cn-easing-ui);
      }
      .nav-toggle-label:hover::before { background-color: var(--cn-hover); }
      .nav-toggle-label:active::before { background-color: var(--cn-active); }
      .shell:has(.nav-toggle:focus-visible) .nav-toggle-label {
        outline: 2px solid var(--cn-focus-ring);
        outline-offset: 2px;
      }
      /* The label names the control visually only for a sighted pointer user;
         the checkbox's own aria-label is what assistive technology reports,
         so both spans are clipped from view rather than shown as a pill. */
      .nav-toggle-open,
      .nav-toggle-close {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .nav-toggle-close { display: none; }
      .shell:has(.nav-toggle:checked) .nav-toggle-open { display: none; }
      .shell:has(.nav-toggle:checked) .nav-toggle-close { display: inline; }

      /*
       * Below --cn-breakpoint-small the bar hides its own leading glyph and
       * reserves eight grid units at its start edge for exactly this trigger
       * (CnAppBar.astro) — there is no rail to hold it instead. Lifting it out
       * of the actions flow and into that reserved slot is what fills it;
       * left in place at the bar's end, the slot would just be empty space.
       */
      @media (max-width: 38.75rem) {
        :global(.cn-app-bar .actions .nav-toggle-label) {
          position: absolute;
          inset-block: 0;
          inset-inline-start: 0;
          inline-size: calc(var(--cn-grid) * 8);
        }
      }

      /* Nav placement and disclosure are the shell's concern: it owns the
         toggle. DocsNav styles only its own contents. */
      .shell :global(.docs-nav) {
        grid-area: nav;
        padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2rem);
        background: var(--cn-surface-1);
        border-block-end: 1px solid var(--cn-border);
      }

      /* While a poster paints, the index cedes its surface, as the rail does in
         apps/pelilauta. Without this the poster would show only in the gutters
         and the page would misrepresent what mounting one looks like.

         The bar keeps its own surface: it is sticky, so ceding it would
         scroll the book's own prose through it. Its veil is that legibility
         halo, fading in as the poster passes beneath. */
      body:has(#cn-poster) .shell :global(.docs-nav) {
        background: color-mix(in oklch, var(--cn-surface-1), transparent 66%);
      }

      .site-footer {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem clamp(1.25rem, 4vw, 3rem);
        color: var(--cn-text-low);
        border-block-start: 1px solid var(--cn-border);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      @media (max-width: 48rem) {
        .site-footer {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      /* Mobile: drawer closed until the disclosure is checked. visibility, not
         transform alone, keeps closed links out of the tab order. */
      @media (max-width: 59.99rem) {
        .shell :global(.docs-nav) {
          visibility: hidden;
          block-size: 0;
          padding-block: 0;
          border-block-end: 0;
          overflow: hidden;
        }
        .shell:has(.nav-toggle:checked) :global(.docs-nav) {
          visibility: visible;
          block-size: auto;
          padding-block: clamp(1.5rem, 4vw, 2.5rem);
          border-block-end: 1px solid var(--cn-border);
        }
      }

      @media (min-width: 60rem) {
        .shell {
          grid-template-columns: 18rem minmax(0, 1fr);
          grid-template-areas:
            'bar bar'
            'nav book';
        }
        .nav-toggle-label { display: none; }
        .shell :global(.docs-nav) {
          position: sticky;
          inset-block-start: 0;
          align-self: start;
          min-block-size: 100vh;
          border-block-end: 0;
          border-inline-end: 1px solid var(--cn-border);
        }
      }
    </style>
  </body>
</html>
