---
/**
 * Book.astro — the shared document shell for every design-system book.
 *
 * Owns <html>, <head>, the skip link, the masthead, the navigation and the
 * footer. It deliberately does NOT own the page's <h1> or lede: each book's hero
 * carries build-time computed data (declaration counts, live icon vocabulary)
 * that only the book component can produce, and slots do not propagate upward
 * from a rendered <Content /> to this layout. The book's title reaches its <h1>
 * as a prop from the MDX frontmatter instead, so there is one source for it.
 */
import '@design-system/styles/ds.css';
import '@design-system/styles/content-prose.css';
// Prototype-age scaffolding, kept only for the legacy books/*.astro pages that
// consume its hero and stat-tile vocabulary. Prose books do not use it.
import '@design-system/styles/docs.css';
import DocsNav from '../components/DocsNav.astro';
import { groupLabel } from '../lib/books';

interface Props {
  title: string;
  /**
   * Wrap the book in the design system's reading container. A prose book sets it;
   * a legacy books/*.astro page lays out its own full-bleed sections instead, so
   * wrapping it would put a 67ch measure around a page built without one.
   */
  prose?: boolean;
  description: string;
  /** Collection id of the current book, absent on the index page. */
  group?: string;
}

const { title, description, group, prose = false } = Astro.props;
const context = group ? groupLabel(group) : 'Index';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} / Pelilauta Design System</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <div class="shell">
      <header class="masthead">
        <a class="wordmark" href="/">Pelilauta DS</a>
        <span class="context">{context}</span>
        <input
          class="nav-toggle"
          id="nav-toggle"
          type="checkbox"
          aria-label="Show the book index"
        />
        <label class="nav-toggle-label" for="nav-toggle">
          <span class="nav-toggle-open">Browse</span>
          <span class="nav-toggle-close">Close</span>
        </label>
      </header>

      <DocsNav />

      <main class="book" id="content">
        {prose ? (
          <article class="cn-content-prose">
            <h1>{title}</h1>
            <slot />
          </article>
        ) : (
          <slot />
        )}
      </main>
    </div>

    <footer class="site-footer">
      <a href="/">Index</a>
      <slot name="footer-note" />
    </footer>

    <style>
      .skip-link {
        position: fixed;
        z-index: 3;
        inset-block-start: 0;
        inset-inline-start: 50%;
        translate: -50% -110%;
        padding: 0.7rem 1.2rem;
        color: var(--cn-text-high);
        background: var(--cn-surface-1);
        border: 1px solid var(--cn-border);
        border-block-start: 0;
        font-size: 0.8rem;
        transition: translate 0.15s ease-out;
      }
      .skip-link:focus-visible {
        translate: -50% 0;
        outline: 2px solid var(--cn-focus-ring);
        outline-offset: -4px;
      }

      /* Editorial index column beside the book, collapsing under 60rem. */
      .shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        grid-template-areas: 'masthead' 'nav' 'book';
      }
      .masthead { grid-area: masthead; }
      .book { grid-area: book; }

      .masthead {
        position: sticky;
        z-index: 2;
        inset-block-start: 0;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem clamp(1.25rem, 4vw, 3rem);
        color: var(--cn-text-low);
        background: var(--cn-surface);
        border-block-end: 1px solid var(--cn-border);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .wordmark { color: inherit; }
      .context { margin-inline-end: auto; }

      /* Visually hidden but focusable: `hidden` would remove the only
         keyboard route into the drawer. */
      .nav-toggle {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        margin: 0;
        padding: 0;
        border: 0;
        clip-path: inset(50%);
        overflow: hidden;
        white-space: nowrap;
      }
      .nav-toggle-label {
        padding: 0.4rem 0.8rem;
        color: var(--cn-text-high);
        border: 1px solid var(--cn-border);
        border-radius: 999px;
        cursor: pointer;
        font: inherit;
        letter-spacing: inherit;
        text-transform: inherit;
      }
      .shell:has(.nav-toggle:focus-visible) .nav-toggle-label {
        outline: 2px solid var(--cn-focus-ring);
        outline-offset: 2px;
      }
      .nav-toggle-close { display: none; }
      .shell:has(.nav-toggle:checked) .nav-toggle-open { display: none; }
      .shell:has(.nav-toggle:checked) .nav-toggle-close { display: inline; }

      /* Nav placement and disclosure are the shell's concern: it owns the
         toggle. DocsNav styles only its own contents. */
      .shell :global(.docs-nav) {
        grid-area: nav;
        padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2rem);
        background: var(--cn-surface-1);
        border-block-end: 1px solid var(--cn-border);
      }

      .site-footer {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem clamp(1.25rem, 4vw, 3rem);
        color: var(--cn-text-low);
        border-block-start: 1px solid var(--cn-border);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      @media (max-width: 48rem) {
        .site-footer {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      /* Mobile: drawer closed until the disclosure is checked. visibility, not
         transform alone, keeps closed links out of the tab order. */
      @media (max-width: 59.99rem) {
        .shell :global(.docs-nav) {
          visibility: hidden;
          block-size: 0;
          padding-block: 0;
          border-block-end: 0;
          overflow: hidden;
        }
        .shell:has(.nav-toggle:checked) :global(.docs-nav) {
          visibility: visible;
          block-size: auto;
          padding-block: clamp(1.5rem, 4vw, 2.5rem);
          border-block-end: 1px solid var(--cn-border);
        }
      }

      @media (min-width: 60rem) {
        .shell {
          grid-template-columns: 18rem minmax(0, 1fr);
          grid-template-areas:
            'masthead masthead'
            'nav      book';
        }
        .nav-toggle-label { display: none; }
        .shell :global(.docs-nav) {
          position: sticky;
          inset-block-start: 0;
          align-self: start;
          min-block-size: 100vh;
          border-block-end: 0;
          border-inline-end: 1px solid var(--cn-border);
        }
      }
    </style>
  </body>
</html>
