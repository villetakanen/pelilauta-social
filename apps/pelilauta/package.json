{
  "name": "pelilauta",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.21.0+sha512.da3337267e400fdd3d479a6c68079ac6db01d8ca4f67572083e722775a796788a7a9956613749e000fac20d424b594f7a791a5f4e2e13581c5ef947f26968a40",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "sync:proprietary": "node scripts/sync-proprietary-assets.mjs",
    "dev": "node scripts/sync-proprietary-assets.mjs && astro dev",
    "start": "node scripts/sync-proprietary-assets.mjs && astro dev",
    "build": "pnpm --filter @pelilauta/design-system check:icons && node scripts/sync-proprietary-assets.mjs && astro check && astro build && node scripts/check-netlify-ssr-entry.mjs && npm run generateSW",
    "preview": "astro preview",
    "astro": "astro",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test": "vitest run test --exclude test/api",
    "test:api": "NODE_ENV=development node test/api/init-api-test-db.js && NODE_ENV=development npx wait-on http://localhost:4321 && NODE_ENV=development vitest run test/api",
    "test:e2e": "NODE_ENV=development node e2e/init-test-db.js && NODE_ENV=development npx wait-on http://localhost:4321 && NODE_ENV=development playwright test",
    "test:e2e:theme": "THEME_E2E=1 playwright test color-theme.spec.ts --project=chromium",
    "test:e2e:debug": "NODE_ENV=development node e2e/init-test-db.js && NODE_ENV=development npx wait-on http://localhost:4321 && NODE_ENV=development playwright test --debug",
    "generateSW": "SW_DIST_PATH=dist workbox injectManifest workbox.config.cjs",
    "backup:storage": "node tooling/backupStorage.js",
    "postbuild": "node tooling/warm-cache.mjs"
  },
  "dependencies": {
    "@11thdeg/cn-story-clock": "4.0.0-beta.10",
    "@11thdeg/cyan-lit": "4.0.0-beta.30",
    "@astrojs/check": "^0.9.4",
    "@astrojs/netlify": "^8.2.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/svelte": "^9.0.1",
    "@atproto/api": "^0.15.14",
    "@nanostores/persistent": "^1.3.5",
    "@netlify/blobs": "^10.0.11",
    "@sentry/browser": "^10.8.0",
    "@vercel/analytics": "^1.5.0",
    "algoliasearch": "^5.37.0",
    "astro": "^7.2.0",
    "diff": "^8.0.2",
    "file-saver": "^2.0.5",
    "firebase": "^11.9.0",
    "firebase-admin": "^13.3.0",
    "front-matter": "^4.0.2",
    "jszip": "^3.10.1",
    "marked": "^15.0.11",
    "marked-footnote": "^1.2.4",
    "nanostores": "^1.4.2",
    "rss-parser": "^3.13.0",
    "svelte": "^5.56.8",
    "turndown": "^7.2.1",
    "typescript": "^5.9.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.3",
    "@playwright/test": "^1.62.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.5",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.5.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.4",
    "workbox-cli": "^7.4.1"
  }
}
