---
import AuthManager from '@components/svelte/AuthManager.svelte';
import SnackbarHost from '@components/svelte/app/SnackbarHost.svelte';
import CnAppChrome from '@design-system/components/CnAppChrome.astro';
import BaseBar from '@pelilauta/base/chrome/BaseBar.astro';
import BaseFooter from '@pelilauta/base/chrome/BaseFooter.astro';
import BaseHead from '@pelilauta/components/server/BaseHead/BaseHead.astro';
import LibraryRail from '@pelilauta/library/chrome/LibraryRail.astro';
import { t } from 'src/utils/i18n';

// Every page taking this layout belongs to the reader, and every one of them
// verifies the session itself before rendering.

type Props = {
  /** The document's title, as a search result shows it. */
  title?: string;
  description?: string;
};

const { title, description } = Astro.props;
---

<html lang="fi">
  <BaseHead {title} {description} noSharing />
  {/* The scope the tray's stylesheet reads; see Base.astro for why it sits here. */}
  <body data-cn-rail-scope>
    <CnAppChrome>
      <BaseBar>
        <slot name="app-bar" />
      </BaseBar>

      <LibraryRail />
      {
        Astro.slots.has('fab-tray') && (
          <nav class="fab-tray" aria-label={t("app:quickActions")}>
            <slot name="fab-tray" />
          </nav>
        )
      }
    </CnAppChrome>

    <main class="app-main">
      <slot />
      <BaseFooter>
        <slot name="app-footer-credits" slot="app-footer-credits" />
      </BaseFooter>
    </main>

    <slot name="app-background-poster" />
    <AuthManager client:only="svelte" />

    <SnackbarHost client:only="svelte" />
  </body>
</html>
