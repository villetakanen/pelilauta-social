---
import AuthManager from '@components/svelte/AuthManager.svelte';
import CnAppChrome from '@design-system/components/CnAppChrome.astro';
import AdminBar from '@pelilauta/admin/chrome/AdminBar.astro';
import AdminRail from '@pelilauta/admin/chrome/AdminRail.astro';
import AppFooter from '@pelilauta/components/server/app/AppFooter.astro';
import BaseHead from '@pelilauta/components/server/BaseHead/BaseHead.astro';
import BaseTail from '@pelilauta/components/server/BaseTail.astro';

// Every page taking this layout states the guard itself, and renders for a
// reader holding the tools alone.

type Props = {
  /** The document's title, as a search result shows it. */
  title?: string;
  description?: string;
};

const { title, description } = Astro.props;
---

<html lang="fi">
  <BaseHead {title} {description} noSharing />
  {/* The scope the tray's stylesheet reads; see Base.astro for why it sits here. */}
  <body data-cn-rail-scope>
    <CnAppChrome>
      <AdminBar>
        <slot name="app-bar" />
      </AdminBar>

      <AdminRail />
    </CnAppChrome>

    <main class="app-main">
      <slot />
      <AppFooter />
    </main>

    <AuthManager client:only="svelte" />

    <BaseTail />
  </body>
</html>
