---
import CnAppBar from '@design-system/components/CnAppBar.astro';
import CnAppChrome from '@design-system/components/CnAppChrome.astro';
import { t } from 'src/utils/i18n';
import AppRail from '../components/server/AppRail.astro';
import BaseHead from '../components/server/BaseHead/BaseHead.astro';
import BaseTail from '../components/server/BaseTail.astro';

// NOTE: ModalPage intentionally does not include AuthManager.
// This layout is only used for server-side authenticated pages where
// authentication is verified during server-side rendering.
// Client-side auth state management is not needed for these pages.

// IMPORTANT: ModalPages are popup-like interfaces for authenticated actions
// and should NEVER be indexed by search engines, similar to editor pages.

export interface Props {
  title?: string;
  shortTitle?: string;
  description?: string;
  image?: string;
  /**
   * Where the bar's back action leads. A route that states none returns
   * through the session instead, as this layout did before the local bar.
   */
  backHref?: string;
}

const { title, shortTitle, description, image, backHref } = Astro.props;
---

<html lang="fi">
  <BaseHead {title} {description} {image} noSharing={true} />
  <body>
    <CnAppChrome>
      <CnAppBar
        title={title ?? ''}
        shortTitle={shortTitle}
        modal
        backLabel={t('actions:back')}
      />
      <slot name="fab-tray" />
    </CnAppChrome>

    <AppRail hideOnMobile />

    <main class="app-main">
      <slot />
    </main>

    {/*
      The design system's back action reports the reader's intent and navigates
      nothing, so where they land is decided here. Without a stated destination
      this is v18's behaviour: back through the session, and the front page when
      the session holds nothing to go back to.
    */}
    <script is:inline define:vars={{ backHref }}>
      document.addEventListener('cn-back', () => {
        if (backHref) {
          window.location.href = backHref;
          return;
        }
        if (window.history.length > 1) {
          window.history.back();
          return;
        }
        window.location.href = '/';
      });
    </script>

    <BaseTail />
  </body>
</html>
