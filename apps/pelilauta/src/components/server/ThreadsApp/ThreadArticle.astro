---
import CnLightbox from '@design-system/components/CnLightbox.svelte';
import type { Thread } from 'src/schemas/ThreadSchema';
import { t } from 'src/utils/i18n';
import { markdownToHTML } from 'src/utils/marked';
import QuoteBubble from './QuoteBubble.astro';

interface Props {
  thread: Thread;
}
const { thread } = Astro.props;
const htmlContent = await markdownToHTML(
  thread.markdownContent || thread.content || '',
);

const figures =
  thread.images?.map((image) => ({
    src: image.url,
    caption: image.alt,
  })) || [];
---
<article>
  <h1 class="downscaled">
    {thread.title}
  </h1>
  { thread.quoteRef && (
    <QuoteBubble 
      threadKey={thread.quoteRef.split('/')[0]}
      replyKey={thread.quoteRef.split('/')[1]}
    />
  )}
  { figures.length > 0 && (
    <CnLightbox
      images={figures}
      openLabel={t('actions:openImage')}
      closeLabel={t('actions:close')}
      client:load
    />
  )}
  <section set:html={htmlContent} />
  
</article>