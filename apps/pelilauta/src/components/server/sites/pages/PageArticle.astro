---
import type { Page } from '@schemas/PageSchema';
import type { Site } from '@schemas/SiteSchema';
import PageArticleFooter from './PageArticleFooter.astro';

interface Props {
  page: Page;
  site: Site;
}
const { site, page } = Astro.props as Props;
---

<article class="surface">

  <div 
    style="min-height: 70dvh" 
    set:html={page.htmlContent}>
  </div>

  <PageArticleFooter page={page} site={site}/>
</article>

 

<style>
  /*
   * The Golden container places this article and reaches no deeper, so the interval
   * between the page body and the footer is stated here.
   */
  article {
    display: grid;
    row-gap: var(--cn-line);
  }
</style>
