---
import CnCard from '@design-system/components/CnCard.svelte';
import CnIcon from '@design-system/components/CnIcon.svelte';
import { t } from '@utils/i18n';
import { generateSrcset, netlifyImage } from '@utils/images/netlifyImage';
import type { Thread } from 'src/schemas/ThreadSchema';
import { toDisplayString } from 'src/utils/contentHelpers';
import { createRichSnippet } from 'src/utils/snippetHelpers';
import ProfileLink from '../../svelte/app/ProfileLink.svelte';
import ReactionButton from '../../svelte/app/ReactionButton.svelte';
import CardSubscription from '../../svelte/frontpage/CardSubscription.svelte';

export interface Props {
  thread: Thread;
  noun: string;
}

const { thread, noun } = Astro.props;

// The poster is the thread's primary image. `parseThread` derives it from the first
// image where a thread has none, so a card reads the one field.
const posterUrl = thread.poster;

// Generate optimized image URLs for the thread poster
// Cards are 170-450px wide, so we use appropriate sizes
// Only use Netlify CDN in production (not available in local dev)
const isProduction = import.meta.env.PROD;
const poster = posterUrl
  ? isProduction
    ? netlifyImage(posterUrl, { width: 450, format: 'webp', quality: 85 })
    : posterUrl
  : undefined;
const posterSrcset = posterUrl
  ? isProduction
    ? generateSrcset(posterUrl, [170, 300, 450], {
        format: 'webp',
        quality: 85,
      })
    : undefined
  : undefined;

const snippet = await createRichSnippet(thread.markdownContent || '', {
  maxLength: 220,
  headerClasses: ['text-h5'],
});

const channel = thread.channel || 'Yleinen';
const channelSlug = channel.toLowerCase().replace(/\s+/g, '-');
---

<!--
  The wrapper carries the card's handle: CardSubscription resolves the reader's
  unread state in the browser and toggles CnCard's `has-notify` state class on a
  CnCard that is server-rendered and never hydrated.
-->
<div id={`thread-card-${thread.key}`} style="flex-basis: auto; width: 100%">
  <CnCard
    href={`/threads/${thread.key}`}
    title={thread.title}
    cover={poster}
    srcset={posterSrcset}
    sizes="(max-width: 768px) 100vw, 450px"
    elevation={1}
    {noun}
  >
    <Fragment slot="eyebrow">
      {t("threads:card.inChannel")}
      <a href={`/channels/${channelSlug}`}>{channel}</a>
    </Fragment>

    <Fragment set:html={snippet} />
    <CardSubscription thread={thread} client:only="svelte" />

    <Fragment slot="actions">
      <p class="m-0 px-1 text-small">
        <ProfileLink uid={thread.owners?.[0] || ""} client:only="svelte" />
        <br />
        {toDisplayString(thread.flowTime)}
      </p>

      <ReactionButton
        key={thread.key}
        title={thread.title}
        target="thread"
        client:only="svelte"
      />

      <!-- Link to discussion -->
      <a
        href={`/threads/${thread.key}?jumpTo=unread#discussion`}
        class="px-1 flex"
      >
        <CnIcon noun="discussion" size="small" />
        <span class="text-caption">{thread.replyCount || 0}</span>
      </a>
    </Fragment>
  </CnCard>
</div>
