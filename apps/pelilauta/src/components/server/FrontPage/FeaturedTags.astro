---
import CnIcon from '@design-system/components/CnIcon.svelte';
import { t } from '@utils/i18n';

const featuredTags = [
  {
    tag: 'd&d',
    displayName: 'D&D',
    icon: 'dd5',
  },
  {
    tag: 'pathfinder',
    displayName: 'Pathfinder',
    icon: 'pathfinder',
  },
  {
    tag: encodeURI('Legendoja & lohikäärmeitä'),
    displayName: 'L&L',
    icon: 'll-ampersand',
  },
  {
    tag: 'pbta',
    displayName: 'PbtA',
    icon: 'pbta-logo',
  },
];
---

<section class="content-prose">
  <h2 class="text-h3">{t('frontPage:featuredTags.title')}</h2>
  <p class="text-caption">{t('frontPage:featuredTags.description')}</p>
  
  <div class="chip-list">
    {featuredTags.map((item) => (
      <a href={`/tags/${encodeURIComponent(item.tag)}`} class="chip">
        <CnIcon noun={item.icon} size="xsmall" />
        <span>{item.displayName}</span>
      </a>
    ))}
  </div>
</section>
