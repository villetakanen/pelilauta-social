---
/*
 * What the region holds while the stream is deferred:
 * `specs/pelilauta/syndicated-feeds/spec.md`.
 *
 * It carries the same heading in the same bare region, so the region keeps its track
 * and its name while a publisher is still being waited on and the page does not jump
 * when the posts arrive.
 */
import CnLoader from '@design-system/components/CnLoader.svelte';
import { t } from '@utils/i18n';
---
<section>
  <h2 class="text-h3">{t('frontPage:syndicate.title')}</h2>
  <CnLoader noun="fox" />
</section>

<style>
  /*
   * The Triad container places this section and reaches no deeper, so the rhythm
   * between the heading and the loader is stated here.
   */
  section {
    display: grid;
    row-gap: var(--cn-line);
  }
</style>
