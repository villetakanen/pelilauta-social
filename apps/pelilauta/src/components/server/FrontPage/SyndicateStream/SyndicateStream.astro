---
/*
 * The syndicated stream: `specs/pelilauta/syndicated-feeds/spec.md`.
 *
 * One stream, newest first, from every publisher the configuration names. The route is
 * the only thing here that reaches the network, so this reads no feed address, imports
 * no parser, and holds no publisher's name in its markup.
 */
import type { FeedData } from '@pages/api/rss-feeds.json';
import { t } from '@utils/i18n';
import { logError } from '@utils/logHelpers';
import {
  mergeSyndicateFeeds,
  type SyndicatedPost,
} from './mergeSyndicateFeeds';
import SyndicatePost from './SyndicatePost.astro';

let posts: SyndicatedPost[] = [];

try {
  const response = await fetch(`${Astro.url.origin}/api/rss-feeds.json`);
  if (response.ok) {
    posts = mergeSyndicateFeeds((await response.json()) as FeedData);
  } else {
    logError(
      'SyndicateStream',
      `rss-feeds.json answered ${response.status} ${response.statusText}`,
    );
  }
} catch (error) {
  logError('SyndicateStream', 'Failed to read the syndicated feeds', error);
}
---
<!--
  The stream itself carries no surface: the region rests in the page like its sibling
  columns, and it is already an occupied Triad region, so it needs no `content-prose` to
  give its children the rhythm. Each post below carries the surface instead, and the
  gap between them is the column grid's, so nothing here states a line between posts.
-->
<section>
  <h2 class="text-h3">{t('frontPage:syndicate.title')}</h2>
  {posts.map((post) => <SyndicatePost {post} />)}
</section>
