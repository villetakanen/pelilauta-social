---
/*
 * One syndicated post: `specs/pelilauta/syndicated-feeds/spec.md`.
 *
 * Not a CnCard. A card carries a cover, actions and an elevation, and this carries a
 * publisher, a title and a snippet — composing one would mean turning four of its
 * features off. What it composes instead is typography and the surface each post
 * stands on, at its default elevation 1, the level payload takes beside it in the
 * neighbouring column.
 */
import type { SyndicatedPost } from './mergeSyndicateFeeds';

type Props = {
  post: SyndicatedPost;
};

const { post } = Astro.props;
---
<section class="surface elevation-0">
  <p class="text-caption"><a href={post.homeUrl}>{post.label}</a></p>
  <h3 class="text-h4"><a href={post.link}>{post.title}</a></h3>
  <p class="text-small">{post.contentSnippet}</p>
</section>

<style>
  /*
   * A title that is a link reads as a title first. Links carries the underline for
   * running text, where a link has to be findable inside a sentence; a heading is
   * already the thing being pointed at, and the mark on hover is what confirms it.
   *
   * This is a view's override of one element, so it is stated here rather than published
   * as a class. CnCard states the same treatment inside its own box, and a third
   * consumer is the point at which Links should publish it.
   */
  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    text-decoration: underline;
  }
</style>
