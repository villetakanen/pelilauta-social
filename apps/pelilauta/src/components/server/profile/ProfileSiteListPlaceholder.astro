---
import CnLoader from '@design-system/components/CnLoader.svelte';
import { t } from 'src/utils/i18n';

/*
 * The server:defer fallback for ProfileSiteList. It keeps the section and its
 * heading, so the column does not move when the real list arrives, and shows a
 * loader where the cards will be. It renders no card: a card stands for one site,
 * and there is no site to stand for yet.
 */
---

<section>
  <h2>{t("profile:siteList.title")}</h2>
  <CnLoader />
</section>
