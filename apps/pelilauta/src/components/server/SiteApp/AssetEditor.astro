---
import { parseAsset } from 'src/schemas/AssetSchema';
import type { Site } from 'src/schemas/SiteSchema';
import AssetEditorComp from '../../svelte/sites/assets/AssetEditor.svelte';

interface Props {
  site: Site;
  assetName: string;
}

const { site, assetName } = Astro.props as Props;
const assetData = site.assets?.find((asset) => asset.name === assetName);

if (!assetData) {
  throw new Error(`Asset ${assetName} not found`);
}

const asset = parseAsset(assetData);
---
<div class="content-golden">
  <article class="surface elevation-1">
    <figure>
      <img src={asset.url} alt={asset.name} />
      <figcaption>{asset.name}</figcaption>
    </figure>
  </article>
  <article class="surface">
    <AssetEditorComp {site} {asset} client:only="svelte" />
  </article>
</div>

<style>
  figure {
    display: grid;
    row-gap: var(--cn-line);
  }

  img {
    max-inline-size: 100%;
    block-size: auto;
  }
</style>