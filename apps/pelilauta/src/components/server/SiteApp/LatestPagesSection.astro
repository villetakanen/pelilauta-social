---
import type { Site } from 'src/schemas/SiteSchema';
import LatestChanges from './LatestChanges.astro';

interface Props {
  site: Site;
}
const { site } = Astro.props as Props;
---
{site.useRecentChanges && (
<section class="surface">
  <LatestChanges site={site} />
</section>
)}

<style>
  .surface {
    display: grid;
    row-gap: var(--cn-line);
  }
</style>