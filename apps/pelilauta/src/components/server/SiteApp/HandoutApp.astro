---
import type { Handout } from 'src/schemas/HandoutSchema';
import type { Site } from 'src/schemas/SiteSchema';
import HandoutMeta from '../../svelte/sites/handouts/HandoutMeta.svelte';

interface Props {
  handout: Handout;
  site: Site;
}

const { handout, site } = Astro.props as Props;
---
<div class="content-golden">
  <section class="handout surface elevation-1">
    <h1>{handout.title}</h1>
    <div class="text-prose" set:html={handout.htmlContent}></div>
  </section>
  <div>
    <HandoutMeta handout={handout} site={site} client:only="svelte"/>
  </div>
</div>

<style>
  /*
   * The Golden container places this section and reaches no deeper, so the interval
   * between the title and the handout body is stated here.
   */
  .handout {
    display: grid;
    row-gap: var(--cn-line);
  }
</style>
