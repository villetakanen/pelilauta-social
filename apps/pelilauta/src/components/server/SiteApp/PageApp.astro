---
import PageArticle from '@components/server/sites/pages/PageArticle.astro';
import type { Page } from 'src/schemas/PageSchema';
import type { Site } from 'src/schemas/SiteSchema';
import LatestPagesSection from './LatestPagesSection.astro';
import PageSidebar from './PageSidebar.astro';

interface Props {
  page: Page;
  site: Site;
}
const { site, page } = Astro.props as Props;
---
<div class="content-golden">

  <PageArticle {page} {site} />

  <!--
    Both asides share the secondary region rather than taking one each:
    LatestPagesSection renders nothing unless the site enables recent changes, and a
    grid item that renders nothing still leaves its track reserved.
  -->
  <div class="asides">
    <PageSidebar site={site} />
    <LatestPagesSection site={site} />
  </div>

</div>

<style>
  /*
   * The Golden container places this box and reaches no deeper, so the interval
   * between the two asides is stated here.
   */
  .asides {
    display: grid;
    row-gap: var(--cn-line);
    min-inline-size: 0;
  }
</style>
