---
/*
 * This is a placeholder component for a server:defer component.
 *
 * It's used to display the loader animation while the actual component is being loaded.
 */
import CnLoader from '@design-system/components/CnLoader.svelte';

interface Props {
  class?: string; // for a legacy column type, eg. 'column-l, column-s or full-width'
  noun?: string; // the icon to show
}
const { class: extraClass, noun: customNoun } = Astro.props;
const noun = customNoun || 'fox';
---
<section class:list={['flex', 'flex-col', 'items-center', extraClass]}>
  <CnLoader {noun} />
</section>
