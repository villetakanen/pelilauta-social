---
import { t } from 'src/utils/i18n';

/**
 * The application's chrome layer: the viewport-sized box the FAB tray pins to.
 *
 * specs/design-system/fab-tray/spec.md places the tray against a container whose
 * border box is 100dvw by 100dvh, and forbids it resolving against the browser
 * viewport. Pelilauta scrolls the document, so `body` cannot be that container — it
 * grows with its content, and the tray would pin to the bottom of the page. This layer
 * is that container instead, and scroll ownership stays where it is.
 */
---

<div class="app-chrome">
  <nav class="fab-tray" aria-label={t('navigation:quickActions')}>
    <slot />
  </nav>
</div>

<style>
  /*
   * z-index is required, not decorative: `container-type` applies layout containment,
   * which makes this layer a stacking context, so the tray's own --cn-z-fab resolves
   * inside it. Without it the layer would paint below Cyan's fixed rail and take the
   * tray with it.
   */
  .app-chrome {
    position: fixed;
    inset: 0;
    z-index: var(--cn-z-fab);
    container: app-chrome / inline-size;
    pointer-events: none;
  }
</style>
