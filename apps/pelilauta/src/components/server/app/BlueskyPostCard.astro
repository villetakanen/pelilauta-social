---
import CnIcon from '@design-system/components/CnIcon.svelte';
import { t } from '@utils/i18n';
import type { BskyPost } from '@utils/server/bsky/fetchBskyPost';

interface Props {
  post: BskyPost;
  postUrl: string;
}

const { post, postUrl } = Astro.props;
---

<article class="surface">
  <div class="text-center">
    <h2>
      {t("threads:info.blueskyTitle")}
    </h2>
    <a
      href={postUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="button text"
      aria-label={t("threads:info.viewOnBluesky")}
    >
      <CnIcon noun="bsky" size="small" />
    </a>
  </div>

  <hr />
  <div class="counts">
    <div class="count">
      <CnIcon noun="love" size="small" />
      <span>
        {post.likeCount}
      </span>
    </div>
    <div class="count">
      <CnIcon noun="discussion" size="small" />
      <span>
        {post.replyCount}
      </span>
    </div>
    <div class="count">
      <CnIcon noun="send" size="small" />
      <span>
        {post.repostCount}
      </span>
    </div>
  </div>
</article>

<style>
  /*
   * The card is nested inside the info column, well below the container that
   * placed the column, so nothing above it states the interval between the
   * title row and the count rows. The card states it.
   */
  article {
    display: grid;
    row-gap: var(--cn-line);
  }

  /*
   * The hr above states the separation Cyan's border-t carried on each cell.
   */
  .counts {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cn-gap);
  }

  .count {
    display: flex;
    flex-direction: row;
    gap: var(--cn-gap);
  }
</style>
