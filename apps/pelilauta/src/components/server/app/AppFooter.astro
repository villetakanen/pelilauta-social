---
import CnIcon from '@design-system/components/CnIcon.svelte';
// The release the reader is on is the repository's, which the beta version
// carries and CI tags.
import { version } from '@root/package.json';
import { t } from 'src/utils/i18n';
import ActiveUsersWidget from './ActiveUsersWidget.astro';
---

<footer>
  <div class="content-columns">
    <section class="text-center">
      <span style="display:contents; color:var(--cn-color-text-low);"><CnIcon noun="fox" size="xlarge" /></span>
      <p class="text-center">
      {t('app:shortname')}<br>
      <a href="/docs/80-release-notes">{version}</a></p>
      <p class="text-caption text-center">
        <a href="/rss/threads.xml">RSS</a>
      </p>
      <div class="text-caption">
        <slot name="app-footer-credits" />
      </div>
  </section>
  <section>
    <h4>{t('app:footer.links.title')}</h4>
    <ul>
      <li>
        <a href="https://myrrys.com">Myrrys</a>
      </li>
      <li>
        <a href="https://discord.gg/c5bAGzNKZz">Roolipelifoorumi -discord</a>
      </li>
      <li>
        <a href="https://discord.gg/2MHBhzw">Roolipelit -discord</a>
      </li>
      <li>
        <a href="https://roolipelitiedotus.fi/">Roolipelitiedotus</a>
      </li>
      <li>
        <a href="https://lollo.ilmatar.net/index.php?title=Etusivu">L&L OGL Wiki</a>
      </li>
    </ul>
  </section>

  <section>
    <ActiveUsersWidget /> 
  </section>
  </div>
</footer>
