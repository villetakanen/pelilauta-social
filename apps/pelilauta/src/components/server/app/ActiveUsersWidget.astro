---
import { t } from 'src/utils/i18n';
import { logError } from 'src/utils/logHelpers';
import AvatarLink from '../../svelte/app/AvatarLink.svelte';

// Fetch active users from the API and display the first 11 in the footer of the
// app, with a count standing for the rest.
//
// On error, the widget will simply not be displayed -
// and the error will be logged.

const SHOWN = 11;

let activeUids: string[] = [];
let overflow = 0;

try {
  const activeUidsRequest = await fetch(
    `${Astro.url.origin}/api/accounts/active.json`,
  );
  const response = await activeUidsRequest.json();
  if (!Array.isArray(response)) {
    throw new Error('Invalid response format: expected array');
  }
  activeUids = response.slice(0, SHOWN);
  overflow = Math.max(0, response.length - activeUids.length);
} catch (e) {
  logError(e, 'Failed to fetch active users');
}
---
{activeUids.length > 0 && (
  <section class="active-users-widget">
    <h4>{t('app:footer.activeUsers.title')}</h4>
    <ul class="cn-avatar-list">
      {activeUids.map((uid: string) => (
        <li><AvatarLink uid={uid} size="medium" client:only="svelte"/></li>
      ))}
      {overflow > 0 && (
        <li>
          <span class="cn-avatar-list__overflow" aria-hidden="true">
            +{overflow}
          </span>
        </li>
      )}
    </ul>
  </section>
)}

<style>
/*
 * AvatarLink resolves its profile in the browser, so each island is empty until
 * it hydrates and the list would collapse and then jump. Hold the small mark's
 * box until then. Retire this with the island: v20 resolves the profile upstream
 * and renders the mark on the server.
 */
.active-users-widget li {
  min-inline-size: var(--cn-avatar-size-medium);
  min-block-size: var(--cn-avatar-size-medium);
}
</style>