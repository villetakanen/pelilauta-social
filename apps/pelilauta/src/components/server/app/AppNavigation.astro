---
/**
 * Pelilauta's application navigation: the rail's boxes from the design system,
 * what stands in them from here.
 *
 * Entries are the consumer's, so each is an ordinary chrome action — an anchor,
 * an Icon and a label — and this component states which one the reader is on.
 * Three entries read the session on the client and stay islands.
 *
 * What it holds, who sees each entry and which route makes one current are
 * `specs/pelilauta/navigation/spec.md`'s; this component states none of them.
 */
import CnRail from '@design-system/components/CnRail.astro';
import Icon from '@design-system/components/Icon.svelte';
import { t } from 'src/utils/i18n';
import AdminNavigationButton from '../../svelte/admin/AdminNavigationButton.svelte';
import SettingNavigationButton from '../../svelte/app/SettingNavigationButton.svelte';
import InboxNavigationButton from '../../svelte/inbox/InboxNavigationButton.svelte';

const path = Astro.url.pathname;

/** The front page is the one entry an ancestor match would claim every page for. */
const home = path === '/';
/** v18's rail treats a thread and its channel index as one destination. */
const threads = path.startsWith('/channels') || path.startsWith('/threads/');
const library = path.startsWith('/library');
const docs = path.startsWith('/docs');

/** What a chrome action carries when it is where the reader is, and when it is not. */
function current(here: boolean) {
  return here ? 'page' : undefined;
}
---

<CnRail label={t('navigation:main')}>
  <a class="chrome-action" href="/" aria-current={current(home)}>
    <Icon noun="fox" decorative />
    <span>{t("navigation:home")}</span>
  </a>

  <a class="chrome-action" href="/channels" aria-current={current(threads)}>
    <Icon noun="discussion" decorative />
    <span>{t("navigation:threads")}</span>
  </a>

  <a class="chrome-action" href="/library" aria-current={current(library)}>
    <Icon noun="books" decorative />
    <span>{t("navigation:library")}</span>
  </a>

  <AdminNavigationButton
    client:only="svelte"
    ariaCurrent={current(path.startsWith("/admin"))}
  />

  <a class="chrome-action" href="/docs/01-index" aria-current={current(docs)}>
    <Icon noun="design" decorative />
    <span>{t("navigation:docs")}</span>
  </a>

  <InboxNavigationButton
    client:only="svelte"
    slot="footer"
    ariaCurrent={current(path.startsWith("/inbox"))}
  />

  <SettingNavigationButton
    client:only="svelte"
    slot="footer"
    ariaCurrent={current(path.startsWith("/settings"))}
  />
</CnRail>
