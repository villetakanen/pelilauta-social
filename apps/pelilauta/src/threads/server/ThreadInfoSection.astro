---
import CnIcon from '@design-system/components/CnIcon.svelte';
import { isAdmin } from '@firebase/server/admin';
import BlueskyPostCard from '@pelilauta/components/server/app/BlueskyPostCard.astro';
import EntryTagsWithLabelsSection from '@pelilauta/components/server/app/EntryTagsWithLabelsSection.astro';
import ReactionButton from '@pelilauta/components/svelte/app/ReactionButton.svelte';
import BlueskyCard from '@pelilauta/components/svelte/threads/BlueskyCard.svelte';
import ThreadInfoActions from '@pelilauta/components/svelte/threads/ThreadInfoActions.svelte';
import { verifySession } from '@utils/server/auth/verifySession';
import { fetchBskyPost } from '@utils/server/bsky/fetchBskyPost';
import type { PublicProfile } from 'src/schemas/ProfileSchema';
import type { Thread } from 'src/schemas/ThreadSchema';
import {
  latestReplyFragment,
  type PreparedDiscussion,
} from 'src/threads/server/prepareDiscussion';
import { toDisplayString } from 'src/utils/contentHelpers';
import { t } from 'src/utils/i18n';
import { toDate } from 'src/utils/schemaHelpers';

interface Props {
  thread: Thread;
  /** Public attribution for the opening post's author, or `null` when it does not resolve. */
  authorAttribution: PublicProfile | null;
  /** Targets the reply-count link at the final reply, or the discussion heading when there is none. */
  discussion: PreparedDiscussion;
}

const { thread, authorAttribution, discussion } = Astro.props;
const latestReplyHref = latestReplyFragment(discussion);

const channel = `${thread?.channel || '-'}`;

/*
 * Three dates with three meanings: creation, a later edit, and the thread's
 * latest activity. A record that carries none of a date renders none of it,
 * so a reader never reads a date the thread never had.
 */
const publishedAt = thread.createdAt ? toDate(thread.createdAt) : null;
const storedUpdatedAt = thread.updatedAt ? toDate(thread.updatedAt) : null;
const editedAt =
  publishedAt &&
  storedUpdatedAt &&
  storedUpdatedAt.getTime() > publishedAt.getTime()
    ? storedUpdatedAt
    : null;
const activeAt = thread.flowTime ? new Date(thread.flowTime) : null;

// Check if current user is author or admin
const session = await verifySession(Astro);
const currentUid = session?.uid || '';
const userIsAdmin = currentUid ? await isAdmin(currentUid) : false;
const isAuthorOrAdmin = thread.owners.includes(currentUid) || userIsAdmin;

// Check if Bluesky feature is enabled
const bskyFeatureEnabled = import.meta.env.FEATURE_BSKY === 'true';

// Fetch Bluesky post data if we have a post URI
let blueskyPost = null;
if (thread.blueskyPostUri) {
  blueskyPost = await fetchBskyPost(thread.blueskyPostUri);
}
---

<!--
  The column holds the thread's own boxes: this summary, the Bluesky prompt or embed, and
  the owner's actions. Each is a surface in its own right; the column states no separator
  of its own, only the interval between the boxes.
-->
<section class="thread-info">
  <section class="surface summary">
    <h2>
      <CnIcon noun="discussion" size="small" decorative />
      {t("threads:info.title")}
    </h2>
    <div class="dates text-small">
      {
        publishedAt && (
          <time datetime={publishedAt.toISOString()}>
            {t("threads:info.createdAt", { time: toDisplayString(publishedAt) })}
          </time>
        )
      }
      {
        editedAt && (
          <time datetime={editedAt.toISOString()}>
            {t("threads:info.updatedAt", { time: toDisplayString(editedAt) })}
          </time>
        )
      }
      {
        activeAt && (
          <time datetime={activeAt.toISOString()}>
            {t("threads:info.flowTime", { time: toDisplayString(activeAt) })}
          </time>
        )
      }
    </div>
    <p>
      {
        authorAttribution ? (
          <a class="cn-nick" href={`/profiles/${authorAttribution.key}`}>
            {authorAttribution.nick}
          </a>
        ) : (
          <span>{t("app:meta.anonymous")}</span>
        )
      }{" "}
      {t("threads:info.inTopic")}{" "}
      <a href={`/channels/${channel}`}>
        {channel.charAt(0).toUpperCase() + channel.slice(1)}
      </a>
    </p>
    <div class="actions text-center">
      <a
        class="button text"
        href={latestReplyHref}
        aria-label={t("threads:info.replies", { count: thread.replyCount || 0 })}
      >
        <CnIcon noun="discussion" />
        <span>{thread.replyCount || 0}</span>
      </a>
      <ReactionButton
        target="thread"
        key={thread.key}
        title={thread.title}
        client:only="svelte"
      />
    </div>
  </section>

  <EntryTagsWithLabelsSection thread={thread} />

  {
    blueskyPost && thread.blueskyPostUrl ? (
      <BlueskyPostCard
        post={blueskyPost}
        postUrl={thread.blueskyPostUrl}
        server:defer
      />
    ) : (
      <BlueskyCard
        thread={thread}
        isAuthorOrAdmin={isAuthorOrAdmin}
        bskyFeatureEnabled={bskyFeatureEnabled}
        client:only="svelte"
      />
    )
  }

  <ThreadInfoActions {thread} client:only="svelte" />
</section>

<style>
  /*
   * The Golden container places this column and reaches no deeper, so the interval
   * between the blocks is stated on the column.
   */
  .thread-info {
    display: grid;
    row-gap: var(--cn-line);
  }

  /*
   * The heading carries its icon on the same line as its text.
   */
  h2 {
    display: flex;
    align-items: center;
    gap: var(--cn-gap);
  }

  /*
   * No container reaches into this box, so it states the interval between its
   * own blocks: the heading, the date, the byline and the actions row.
   */
  .summary {
    display: grid;
    row-gap: var(--cn-line);
  }

  /*
   * Each date is its own line: the three say different things, and a reader
   * separates them by reading down rather than by parsing one run of text.
   */
  .dates {
    display: grid;
    row-gap: var(--cn-gap);
  }

</style>
