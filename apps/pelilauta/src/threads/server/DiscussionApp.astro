---
import DiscussionSection from '@pelilauta/threads/client/DiscussionSection.svelte';
import type { Thread } from 'src/schemas/ThreadSchema';
import type { PreparedDiscussion } from 'src/threads/server/prepareDiscussion';

interface Props {
  thread: Thread;
  /** Prepared by the page so `ThreadInfoSection` reads the same discussion. */
  discussion: PreparedDiscussion;
}
const { thread, discussion }: Props = Astro.props;
---
<DiscussionSection discussion={discussion.replies} incomplete={discussion.incomplete} unavailable={discussion.unavailable} {thread} client:load/>
