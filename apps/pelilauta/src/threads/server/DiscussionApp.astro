---
import DiscussionSection from '@pelilauta/threads/client/DiscussionSection.svelte';
import { fetchDiscussion } from 'src/firebase/server/discussion/fetchDiscussion';
import type { Thread } from 'src/schemas/ThreadSchema';
// ERROR: a browser store imported into server code. The public-profile shape,
// its projection and the anonymous fallback need a stateless home; see
// docs/lessons/server-code-imports-the-client-profile-store.md.
import {
  createEmptyPublicProfile,
  normalizeProfileData,
  type PublicProfile,
} from 'src/stores/profiles';
import { fetchApiJson } from 'src/utils/server/fetchApi';

interface Props {
  thread: Thread;
}
const { thread }: Props = Astro.props;

const discussion = await fetchDiscussion(thread.key);

// The profile route is the reader. An author it cannot answer for is
// anonymous in the document, so the browser has no profile left to look up.
const authorUids = [
  ...new Set(discussion.map((reply) => reply.owners[0]).filter(Boolean)),
];
const authors: Record<string, PublicProfile> = Object.fromEntries(
  await Promise.all(
    authorUids.map(async (uid): Promise<[string, PublicProfile]> => {
      const json = await fetchApiJson(
        Astro,
        `/api/profiles/${encodeURIComponent(uid)}.json`,
      );
      if (json === null) return [uid, createEmptyPublicProfile(uid)];
      try {
        return [uid, normalizeProfileData(json, uid)];
      } catch {
        return [uid, createEmptyPublicProfile(uid)];
      }
    }),
  ),
);
---
<DiscussionSection discussion={discussion} {thread} {authors} client:load/>
