---
import DiscussionSection from '@pelilauta/threads/client/DiscussionSection.svelte';
import type { Thread } from 'src/schemas/ThreadSchema';
import { prepareDiscussion } from 'src/threads/server/prepareDiscussion';

interface Props {
  thread: Thread;
}
const { thread }: Props = Astro.props;

const discussion = await prepareDiscussion(thread.key);
---
<DiscussionSection discussion={discussion.replies} incomplete={discussion.incomplete} {thread} client:load/>
