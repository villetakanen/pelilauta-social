---
import { t } from 'src/utils/i18n';
import CreateSiteForm from '../../components/svelte/sites/CreateSiteForm.svelte';
import ModalPage from '../../layouts/ModalPage.astro';

const title = t('site:create.title');
const shortTitle = t('site:create.title');
---

<ModalPage title={title} shortTitle={shortTitle} backHref="/library">
  <div class="content-prose">
    <h1>{t('site:create.title')}</h1>
    <p>
      {t('site:create.description')}
      <a href="/docs/31-create-site">{t('actions:learnMore')}</a>
    </p>
    <CreateSiteForm client:only="svelte" />
  </div>
</ModalPage>