---
import CnIcon from '@design-system/components/CnIcon.svelte';
import { t } from 'src/utils/i18n';
import BaseHead from '../components/server/BaseHead/BaseHead.astro';

const title = t('app:offline.title');
const description = t('app:offline.description');
---

<!doctype html>
<html lang="fi">
  <BaseHead title={title} description={description} noSharing={true} />
  <body>
    <main class="app-main">
      <div class="content-prose">
        <article class="surface offline-page">
          <div class="text-center">
            <CnIcon noun="fox" size="large" />
          </div>
          
          <h1>{title}</h1>
          
          <p>
            {t('app:offline.message')}
          </p>
          
          <div class="actions justify-end">
            <button 
              type="button"
              class="text"
              onclick="window.history.back()" 
            >
              {t('actions:cancel')}
            </button>
            <button 
              type="button"
              onclick="window.location.reload()" 
            >
              {t('app:offline.tryAgain')}
            </button>
          </div>
        </article>
      </div>
    </main>

    <script is:inline>
      function checkConnectivity() {
        if (navigator.onLine) {
          window.location.reload();
        }
      }

      window.addEventListener('online', checkConnectivity);

      setInterval(() => {
        fetch('/favicon.svg', { 
          method: 'HEAD',
          cache: 'no-cache' 
        })
        .then(() => {
          if (navigator.onLine) {
            window.location.reload();
          }
        })
        .catch(() => {
        });
      }, 10000);

      function updateConnectionStatus() {
        const isOnline = navigator.onLine;
        document.title = isOnline ? 'Back Online - Pelilauta' : 'Offline - Pelilauta';
      }

      window.addEventListener('online', updateConnectionStatus);
      window.addEventListener('offline', updateConnectionStatus);
    </script>
  </body>
</html>

<style>
  .offline-page {
    display: grid;
    row-gap: var(--cn-line);
  }
</style>