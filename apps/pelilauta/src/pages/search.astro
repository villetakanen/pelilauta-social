---
import Base from '@layouts/Base.astro';
import { requireSession } from '@pelilauta/base/utils/requireSession';
import AlgoliaSearchApp from '@svelte/search/AlgoliaSearchApp.svelte';
import { t } from '@utils/i18n';

/* The search page: can be accessed by anyone, but requires a session to use Algolia
 * for cost-optimization */
const { uid, denied } = await requireSession(Astro);
if (denied) return denied;
---
<Base title={t('search:title')}>
  {/*
    The search app is client:only, so a heading inside it does not exist until
    it hydrates. The document's outline states the page here instead, and the
    app's own visible heading names its card.
  */}
  <h1 class="sr-only">{t('search:title')}</h1>
  <AlgoliaSearchApp client:only="svelte" />
</Base>