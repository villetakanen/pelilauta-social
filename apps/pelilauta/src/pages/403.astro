---
import CnIcon from '@design-system/components/CnIcon.svelte';
import Base from '@layouts/Base.astro';
import { t } from 'src/utils/i18n';
---

<Base title={t('seo:error403.title')} noSharing>
  <div class="content-prose">
    <article class="surface error-page">
      <div class="text-center">
        <CnIcon noun="admin" size="large" />
      </div>
      <h1>{t('seo:error403.title')}</h1>
      <p>{t('seo:error403.description')}</p>
      <div class="text-end">
        <a href="/" class="button">
          <CnIcon noun="arrow-left" size="small" />
          {t('app:404.go-home')}
        </a>
      </div>
    </article>
  </div>
</Base>

<style>
  .error-page {
    display: grid;
    row-gap: var(--cn-line);
  }
</style>