---
import CnLoader from '@design-system/components/CnLoader.svelte';
import { t } from 'src/utils/i18n';
import BaseHead from '../components/server/BaseHead/BaseHead.astro';

// Clear any server-side session
Astro.cookies.delete('session', { path: '/' });
---

<html lang="fi">
  <head>
    <BaseHead title={t('actions:logout')} noSharing={true} />
  </head>
  <body>
    <main class="app-main">
      <div class="content-prose">
        <article class="surface logout-page text-center">
          <CnLoader noun="fox" label={t('actions:logout')} />
          <p>{t('actions:logout')}...</p>
        </article>
      </div>
    </main>

    <script>
      // Clear client-side auth and redirect
      import('../stores/session').then(({ logout }) => {
        logout().then(() => {
          window.location.href = '/';
        });
      });
    </script>
  </body>
</html>

<style>
  .logout-page {
    display: grid;
    justify-items: center;
    row-gap: var(--cn-line);
    margin-block-start: var(--cn-line);
  }
</style>
