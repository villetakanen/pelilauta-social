--- 
import { getEntry, render } from 'astro:content';
import EulaForm from '../components/svelte/eula/EulaForm.svelte';
import ModalPage from '../layouts/ModalPage.astro';
import { t } from '../utils/i18n';

const eulaDoc = await getEntry('docs', '03-eula');
if (!eulaDoc) {
  throw new Error('EULA document not found');
}
const { Content } = await render(eulaDoc);
---

<ModalPage title={t('app:docs.title')} backHref="/">
  <EulaForm client:only="svelte">
    <Content />
  </EulaForm>
</ModalPage>
