---
import Base from '@layouts/Base.astro';
import ThreadChatBar from '@pelilauta/threads/client/ThreadChatBar.svelte';
import DiscussionApp from '@pelilauta/threads/server/DiscussionApp.astro';
import ThreadArticle from '@pelilauta/threads/server/ThreadArticle.astro';
import ThreadInfoSection from '@pelilauta/threads/server/ThreadInfoSection.astro';
import { getPublicProfiles } from 'src/firebase/server/profiles';
import { ThreadSchema } from 'src/schemas/ThreadSchema';
import { prepareDiscussion } from 'src/threads/server/prepareDiscussion';
import { t } from 'src/utils/i18n';
import { createPlainSnippet } from 'src/utils/snippetHelpers';

const { threadKey } = Astro.params;

if (!threadKey) {
  return Astro.redirect('/404');
}
// Fetch the tread data from the API
const threadResponse = await fetch(
  `${Astro.url.origin}/api/threads/${threadKey}.json`,
);

if (!threadResponse.ok) {
  return Astro.redirect('/404');
}

// We can expect the Thread to be in client-side format, so
// we'll simply parse it to verify the structure.
const thread = ThreadSchema.parse(await threadResponse.json());

// SEO-optimized title and description
const title = thread.title
  ? `${thread.title} - ${t('app:shortname')}`
  : `${t('app:shortname')} - ${thread.channel}`;

const snippet = createPlainSnippet(thread.markdownContent || '', 160);

// Resolve the opening post's public attribution before rendering.
const authorUid = thread.owners[0];
const authorAttribution = authorUid
  ? ((await getPublicProfiles([authorUid]))[authorUid] ?? null)
  : null;

// Prepared once so ThreadInfoSection's latest-reply control and DiscussionApp's
// initial render agree on the same discussion, without a second Firestore read.
const discussion = await prepareDiscussion(thread.key);
---

<Base
  title={title}
  description={snippet}
>
  <div class="content-golden">
    <ThreadArticle thread={thread} />
    <ThreadInfoSection
      thread={thread}
      authorAttribution={authorAttribution}
      discussion={discussion}
    />
  </div>
  <DiscussionApp thread={thread} discussion={discussion} />
  <ThreadChatBar thread={thread} slot="authoring" client:only="svelte" />
</Base>
