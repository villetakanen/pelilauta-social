---
import FeaturedTags from '@components/server/FrontPage/FeaturedTags.astro';
import CnPoster from '@design-system/components/CnPoster.astro';
import CnPosterCredits from '@design-system/components/CnPosterCredits.astro';
import Base from '@layouts/Base.astro';
import OnboardingCallout from '../components/server/FrontPage/OnboardingCallout.astro';
import SyndicateStream from '../components/server/FrontPage/SyndicateStream/SyndicateStream.astro';
import SyndicateStreamFallback from '../components/server/FrontPage/SyndicateStream/SyndicateStreamFallback.astro';
import TopSitesStream from '../components/server/FrontPage/TopSitesStream.astro';
import TopThreadsStream from '../components/server/FrontPage/TopThreadsStream.astro';
import FrontpageFabs from '../components/svelte/frontpage/FrontpageFabs.svelte';
import { t } from '../utils/i18n';

const title = t('seo:frontPage.title');
const description = t('seo:frontPage.description');
const image = `${Astro.url.origin}/myrrys-proprietary/juno-viinikka/juno-viinikka-dragon-1.webp`;
---
<Base
  search
  {title}
  {description}
  {image}>
    <OnboardingCallout />
    <div class="content-triad">
      <TopThreadsStream />

      <SyndicateStream server:defer>
        <SyndicateStreamFallback slot="fallback" />
      </SyndicateStream>

      <section>
        <TopSitesStream />
        <FeaturedTags />
      </section>
    </div>
    <FrontpageFabs client:only="svelte" slot="fab-tray"/>
    <CnPoster
      slot="app-background-poster"
      src="/myrrys-proprietary/juno-viinikka/juno-viinikka-dragon-1.webp"
      md="/myrrys-proprietary/juno-viinikka/juno-viinikka-dragon-1-960.webp"
    />
    <CnPosterCredits
      note="Taustakuva © Juno Viinikka"
      href="https://linktr.ee/junowski"
      slot="app-footer-credits"
    />
</Base>