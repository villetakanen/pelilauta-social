---
import Icon from '@design-system/components/Icon.svelte';
import { t } from 'src/utils/i18n';
import Page from '../layouts/Page.astro';
---
<Page title={t('seo:error404.title')} noun="warning" noSharing>
  <article class="content-prose">
    <div class="flex justify-center">
      <Icon noun="monsters" size="xlarge" />
    </div>
    <h1>{t("app:404.title")}</h1>
    <p class="subtitle">{t("app:404.subtitle")}</p>
    <p>{t("app:404.info")}</p>
    <ul>
      <li>
        <a href="/">{t("app:404.go-home")}</a>
      </li>
      <li>
        <a href="/sites">{t("app:404.go-sites")}</a>
      </li>
      <li>
        <a href="/threads">{t("app:404.go-threads")}</a>
      </li>
    </ul>
  </article>
</Page>