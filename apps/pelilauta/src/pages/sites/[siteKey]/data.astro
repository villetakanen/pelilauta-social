---
import Site from '@layouts/Site.astro';
import { requireSiteOwner } from '@pelilauta/site/utils/requireSiteOwner';
import { SiteSchema } from 'src/schemas/SiteSchema';
import { toClientEntry } from 'src/utils/client/entryUtils';
import SiteDataApp from '../../../components/svelte/sites/data/SiteDataApp.svelte';

const { siteKey } = Astro.params;

const siteResponse = await fetch(`${Astro.url.origin}/api/sites/${siteKey}`);
if (siteResponse.status === 404) {
  return Astro.redirect('/404');
}

const site = SiteSchema.parse({
  ...toClientEntry(await siteResponse.json()),
  key: siteKey,
});

const denied = await requireSiteOwner(Astro, site);
if (denied) return denied;
---

<Site {site} noSharing={true}>
  <SiteDataApp site={site} client:only="svelte" />
</Site>
