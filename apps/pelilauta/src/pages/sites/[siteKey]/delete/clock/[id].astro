---
import { SiteSchema } from 'src/schemas/SiteSchema';
import { toClientEntry } from 'src/utils/client/entryUtils';
import { t } from 'src/utils/i18n';
import DeleteClockApp from '../../../../../components/svelte/sites/DeleteClockApp.svelte';
import ModalPage from '../../../../../layouts/ModalPage.astro';

const { id, siteKey } = Astro.params;

if (!id || !siteKey) {
  return Astro.redirect('/404');
}

const origin = new URL(Astro.request.url).origin;
const siteResponse = await fetch(`${origin}/api/sites/${siteKey}`);

if (siteResponse.status === 404) {
  return Astro.redirect('/404');
}

const site = SiteSchema.parse({
  ...toClientEntry(await siteResponse.json()),
  key: siteKey,
});
---

<ModalPage title={site.name} backHref={`/sites/${site.key}/clocks`}>
  <div class="content-prose">
    <h1>{t('site:clocks.delete.title')}</h1>
  </div>
  <DeleteClockApp site={site} key={id} client:only="svelte" />
</ModalPage>
