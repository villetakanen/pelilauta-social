---
import { requireSession } from '@pelilauta/base/utils/requireSession';
import { verifySiteAccess } from '@utils/server/auth/verifySiteAccess';
import { t } from 'src/utils/i18n';
import { logError } from 'src/utils/logHelpers';
import PageEditorForm from '../../../../components/svelte/page-editor/PageEditorForm.svelte';
import { getPageData, getSiteData } from '../../../../firebase/server/sites';
import EditorPage from '../../../../layouts/EditorPage.astro';

interface Props {
  siteKey: string;
  pageKey: string;
}
const { siteKey, pageKey } = Astro.params;

if (!siteKey || !pageKey) {
  logError('siteKey or pageKey not found', { siteKey, pageKey });
  return Astro.redirect('/404');
}

const { uid, denied } = await requireSession(Astro);
if (denied) return denied;

const [site, page] = await Promise.all([
  getSiteData(siteKey),
  getPageData(siteKey, pageKey, Astro.url),
]);

if (!site || !page) {
  if (!site) {
    logError('site not found', { siteKey });
  } else {
    logError('page not found', { siteKey, pageKey });
  }
  return Astro.redirect('/404');
}

/*
 * A page is edited by a site member, owner or player: the same rule PageFabs uses
 * to offer the edit action, and the one `sites/[siteKey]/settings.astro` gates on.
 */
const { isMember } = await verifySiteAccess(site, uid);
if (!isMember) {
  return Astro.redirect(`/sites/${siteKey}/${pageKey}`);
}

const title = `${t('app:shortname')} – ${t('site:editor.title')}`;
const shortTitle = t('site:editor.title');
---
<EditorPage title={title} shortTitle={shortTitle} backHref={`/sites/${siteKey}/${pageKey}`}>
  <PageEditorForm site={site} page={page} client:only="svelte"/>
</EditorPage>
