---
import Admin from '@layouts/Admin.astro';
import { requireAdmin } from '@pelilauta/admin/utils/requireAdmin';
import SiteAdmin from '../../components/svelte/admin/SitesAdmin.svelte';
import { t } from '../../utils/i18n';

const denied = await requireAdmin(Astro);
if (denied) return denied;
---

<Admin title={t('admin:title')} description="Site activity and administration">
  <div class="content-prose">
    <SiteAdmin client:only="svelte" />
  </div>
</Admin>
