---
import Icon from '@design-system/components/Icon.svelte';
import Admin from '@layouts/Admin.astro';
import AdminDebugTools from '@pelilauta/admin/client/AdminDebugTools.svelte';
import { requireAdmin } from '@pelilauta/admin/utils/requireAdmin';

import { showDeveloperTools } from '@pelilauta/admin/utils/requireDeveloperTools';

const denied = await requireAdmin(Astro);
if (denied) return denied;
---
<Admin title="Admin" description="Admin tools for pelilauta">
  <div class="content-prose">
    <div class="flex align-center items-center justify-center flex-col">
      <Icon noun="admin" size="xlarge" />
    { showDeveloperTools ? (
      <p class="text-center">ADMIN TOOLS ACTIVE</p>
    ) : <p class="text-center">MOD TOOLS ACTIVE</p> }
      { showDeveloperTools && <AdminDebugTools client:only="svelte" /> }
    </div>
  </div>
</Admin>