---
import CnIcon from '@design-system/components/CnIcon.svelte';
import Admin from '@layouts/Admin.astro';
import AdminDebugTools from '@pelilauta/admin/client/AdminDebugTools.svelte';
import { requireAdmin } from '@pelilauta/admin/utils/requireAdmin';
import { showDeveloperTools } from '@pelilauta/admin/utils/requireDeveloperTools';
import { t } from '../../utils/i18n';

const denied = await requireAdmin(Astro);
if (denied) return denied;
---

<Admin title={t('admin:title')} description={t('admin:description')}>
  <div class="content-prose">
    <article class="surface admin-hub">
      <header class="admin-header">
        <CnIcon noun="admin" size="xlarge" />
        <div>
          <h1>{t('admin:title')}</h1>
          <p class="text-caption text-low">
            {showDeveloperTools ? 'ADMIN TOOLS ACTIVE' : 'MOD TOOLS ACTIVE'}
          </p>
        </div>
      </header>

      {
        showDeveloperTools && (
          <section class="admin-debug-section">
            <h2>Debug & Integration Tools</h2>
            <AdminDebugTools client:only="svelte" />
          </section>
        )
      }
    </article>
  </div>
</Admin>

<style>
  .admin-hub {
    display: grid;
    row-gap: var(--cn-line);
  }

  .admin-header {
    display: flex;
    align-items: center;
    gap: var(--cn-gap);
  }

  .admin-header h1 {
    margin: 0;
  }

  .admin-debug-section {
    display: grid;
    row-gap: var(--cn-grid);
    border-block-start: 1px solid var(--cn-color-border);
    padding-block-start: var(--cn-line);
  }

  .admin-debug-section h2 {
    margin: 0;
    font-size: var(--cn-font-size-small);
    color: var(--cn-color-text-low);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>