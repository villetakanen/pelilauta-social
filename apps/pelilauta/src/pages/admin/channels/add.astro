---
import { requireAdmin } from '@pelilauta/admin/utils/requireAdmin';
import AddChannelForm from '../../../components/svelte/admin/channels/AddChannelForm.svelte';
import ModalPage from '../../../layouts/ModalPage.astro';
import { t } from '../../../utils/i18n';

// Server-side authentication check
const denied = await requireAdmin(Astro);
if (denied) return denied;
---

<ModalPage
  title={t('admin:title')}
  shortTitle={t('admin:channels.add.shortTitle')}
  backHref="/admin/channels"
>
  <section class="content-prose">
    <article class="add-channel-article">
      <header>
        <h1>{t('admin:channels.add.title')}</h1>
        <p class="text-small text-low">
          {t('admin:channels.add.description')}
        </p>
      </header>
      
      <AddChannelForm client:only="svelte" />
      
      <aside class="surface">
        <h3>{t('admin:channels.add.guidelines.title')}</h3>
        <p>{t('admin:channels.add.guidelines.items.unique')}</p>
      </aside>
    </article>
  </section>
</ModalPage>

<style>
  .add-channel-article {
    display: grid;
    row-gap: var(--cn-line);
  }
</style>