---
import Admin from '@layouts/Admin.astro';
import { requireDeveloperTools } from '@pelilauta/admin/utils/requireDeveloperTools';
import UserAdmin from '../../components/svelte/admin/UserAdmin.svelte';
import { t } from '../../utils/i18n';

const denied = await requireDeveloperTools(Astro);
