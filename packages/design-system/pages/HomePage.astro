---
/**
 * Index of the design-system books.
 *
 * The catalog is passed in from the site rather than hand-written, so it cannot
 * drift from the navigation. Grouping and ordering are the site's decision; this
 * component only renders them.
 */
import '@design-system/styles/ds.css';

interface BookEntry {
  title: string;
  description: string;
  href: string;
}

interface BookGroup {
  label: string;
  books: BookEntry[];
}

interface Props {
  title: string;
  groups: BookGroup[];
}

const { title, groups } = Astro.props;

// One running number across all groups, so the index reads as a single spine.
const numbered = groups.flatMap((group) =>
  group.books.map((book) => ({ ...book, group: group.label })),
);
---

<section class="hero index-hero">
  <p class="kicker">PELILAUTA / V21</p>
  <h1>{title}</h1>
  <p class="lede">
    Living books connect design intent to the exact contracts used by Pelilauta.
    Each book ships with its specification and its production implementation.
  </p>
  <dl class="facts">
    <div><dt>Books</dt><dd>{numbered.length}</dd></div>
    <div><dt>Groups</dt><dd>{groups.length}</dd></div>
  </dl>
</section>

<section aria-labelledby="index-title">
  <div class="section-heading">
    <p>THE BOOKS</p>
    <h2 id="index-title">Start anywhere</h2>
  </div>
  <ol class="index-list">
    {numbered.map((book, i) => (
      <li>
        <p class="index-number">
          {String(i + 1).padStart(2, '0')} / {book.group.toUpperCase()}
        </p>
        <h3><a href={book.href}>{book.title}</a></h3>
        <p class="index-blurb">{book.description}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  /* The index keeps a heavier display treatment than the interior books. */
  .index-hero {
    background:
      radial-gradient(circle at 85% 10%, var(--cn-hover), transparent 35rem),
      var(--cn-surface);
  }
  .index-hero h1 {
    max-inline-size: 10ch;
    font-size: clamp(3rem, 11vw, 8rem);
    letter-spacing: -0.06em;
    line-height: 0.88;
  }
  .index-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .index-list li {
    padding-block: 2rem;
    border-block-start: 1px solid var(--cn-border);
  }
  .index-number {
    margin: 0;
    color: var(--cn-text-low);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }
  .index-list h3 {
    margin: 0.75rem 0;
    font-size: clamp(1.6rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .index-list h3 a {
    text-decoration-thickness: 0.06em;
  }
  .index-blurb {
    max-inline-size: 48rem;
    margin: 0;
    color: var(--cn-text-low);
  }
</style>
