---
/**
 * Index of the design-system books.
 *
 * The catalog is passed in from the site rather than hand-written, so it cannot
 * drift from the navigation. Grouping and ordering are the site's decision; this
 * component only renders them.
 *
 * The page is built from what the design system ships: a golden container puts the
 * masthead beside a contents card, a prose container carries the index below it,
 * and the type comes from the typography steps. It states no measure, no rhythm and
 * no type scale of its own — the front page is the first thing a reader sees, and
 * a front page that needed its own vocabulary would be an argument against the
 * books behind it.
 */
import '@design-system/styles/ds.css';

interface BookEntry {
  title: string;
  description: string;
  href: string;
}

interface BookGroup {
  label: string;
  books: BookEntry[];
}

interface Props {
  title: string;
  groups: BookGroup[];
}

const { title, groups } = Astro.props;

// One running number across all groups, so the index reads as a single spine.
const numbered = groups.flatMap((group) =>
  group.books.map((book) => ({ ...book, group: group.label })),
);
---

<section class="content-golden">
  <!-- The golden primary is exactly the readable measure, so the prose container
       nested in it fills the region and gives the column its rhythm. -->
  <div class="content-prose">
    <p class="text-caption text-low">Pelilauta / v21</p>
    <h1 class="text-title">{title}</h1>
    <p class="text-low">
      Living books connect design intent to the exact contracts used by Pelilauta.
      Each book ships with its specification and its production implementation.
    </p>

    <h2>Start anywhere</h2>
    <ol class="index-list">
      {numbered.map((book, i) => (
        <li>
          <p class="text-caption text-low">
            {String(i + 1).padStart(2, '0')} / {book.group}
          </p>
          <h3><a href={book.href}>{book.title}</a></h3>
          <p class="text-small text-low">{book.description}</p>
        </li>
      ))}
    </ol>
  </div>

  <aside class="surface elevation-2">
    <p class="text-caption text-low">Contents</p>
    <dl class="counts">
      {groups.map((group) => (
        <div>
          <dt class="text-small text-low">{group.label}</dt>
          <dd class="text-h4">{group.books.length}</dd>
        </div>
      ))}
    </dl>
  </aside>
</section>

<style>
  .counts {
    display: grid;
    gap: var(--cn-gap);
    margin: 0;
  }
  .counts div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--cn-gap);
  }
  .counts dd {
    margin: 0;
  }

  .index-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* A rule between entries, so the spine reads as one numbered sequence rather
     than as twenty separate blocks. */
  .index-list li {
    padding-block: var(--cn-line);
    border-block-start: 1px solid var(--cn-border);
  }
  .index-list li > * {
    margin-block: 0;
  }
  .index-list h3 {
    margin-block: calc(var(--cn-line) / 2);
  }
</style>
