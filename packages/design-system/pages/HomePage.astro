---
/**
 * The Design System Homepage.
 */

interface BookEntry {
  title: string;
  description: string;
  href: string;
}

interface BookGroup {
  label: string;
  books: BookEntry[];
}

interface Props {
  title: string;
  groups: BookGroup[];
}

import { version } from "../../../package.json";

const { title, groups } = Astro.props;

// One running number across all groups, so the index reads as a single spine.
const numbered = groups.flatMap((group) =>
  group.books.map((book) => ({ ...book, group: group.label })),
);
---

<section class="content-golden">
  <article class="content-area">
    <p class="text-caption text-low">Pelilauta / v{version}</p>
    <h1 class="text-title">{title}</h1>
    <p class="text-low">
      A living Design System for <a href="https://pelilauta.social">Pelilauta.social</a>,
      exploring the Design Language of the app, through "Storybooks" and foundational articles.
    </p>

    <section>
      <h2>Chapters</h2>
      <h3><a href="/principles">Principles</a></h3>
      <p>The foundational concepts, philosophy and principles of the design language.</p>

      <h3><a href="/base">Base</a></h3>
      <p>Base covers the look of plain HTML: the reset, the two typefaces, and how links,
        buttons, fields and dividers appear on their own. Preflight flattens the
        differences between browsers so every element starts from the same place; Lato
        then carries reading and interface text, and Roboto Mono the code and whatever
        the reader types. A page of bare markup reads correctly on Base alone — components
        build on it, and override it only where they set their own layout.</p>

      <h3><a href="/utilities">Utilities</a></h3>
      <p>Utilities provide the optional styling, enriching the Base styles: surfaces and
        their elevation, content areas, layout columns, chips, and the chrome marks. A
        surface wraps content in padding and one of five elevation levels; a content area
        restores document flow to authored text inside the reset. Each adds one
        capability, and can be composed for more complex styling needs.</p>

      <h3><a href="/tokens">Tokens</a></h3>
      <p>The typography, colour and spatial values the whole system draws from.</p>

      <h3><a href="/components">Components</a></h3>
      <p>The reusable Svelte and Astro components, from avatars to application chrome.</p>

      <h3><a href="/extensions">Extensions</a></h3>
      <p>The richer application capabilities built on the components: the editor, dice and clocks.</p>
    </section>

  </article>

  <aside class="surface elevation-2">
    <p class="text-caption text-low">Contents</p>
    <dl class="counts">
      {groups.map((group) => (
        <div>
          <dt class="text-small text-low">{group.label}</dt>
          <dd class="text-h4">{group.books.length}</dd>
        </div>
      ))}
    </dl>
  </aside>
</section>

<style>
  .counts {
    display: grid;
    gap: var(--cn-gap);
    margin: 0;
  }
  .counts div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--cn-gap);
  }
  .counts dd {
    margin: 0;
  }

  .index-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* A rule between entries, so the spine reads as one numbered sequence rather
     than as twenty separate blocks. */
  .index-list li {
    padding-block: var(--cn-line);
    border-block-start: 1px solid var(--cn-color-border);
  }
  .index-list li > * {
    margin-block: 0;
  }
  .index-list h3 {
    margin-block: calc(var(--cn-line) / 2);
  }
</style>
