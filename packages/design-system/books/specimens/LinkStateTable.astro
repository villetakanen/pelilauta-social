---
/**
 * LinkStateTable — every native-link state rendered in Light and Dark.
 *
 * Browsers cannot hold hover, active and keyboard focus at once. This specimen
 * extracts, from the shipped stylesheet, only the selectors that name one of
 * those pseudo-classes, scopes and remaps just those to a documentation-only
 * `data-link-state` attribute — the technique `ChromeActionSpecimens.astro`
 * uses. Copying the whole file would re-inject the resting rules with a class
 * of extra specificity, and a real pointer over any link in the table would
 * then show nothing; extraction leaves the resting treatment, and real
 * interaction, to the stylesheet the design site already loads.
 *
 * Book: apps/design/src/content/base/links-actions-buttons.mdx
 */
interface Props {
  /** styles/links.css, imported by the book with `?raw`. */
  source: string;
}

const { source } = Astro.props;

const LINK_SELECTOR = 'a:where([href]:not(.button, .fab, .chip))';
const states = [
  {
    name: 'Resting',
    attribute: undefined,
    label: 'Read the typography principles',
    href: '/principles/typography',
    treatment: 'Underlined, using --cn-color-link.',
    purpose: 'Keeps navigation identifiable without relying on colour.',
  },
  {
    name: 'Visited',
    attribute: 'visited',
    label: 'Return to this book',
    href: '/base/links-actions-buttons',
    treatment: 'The resting treatment.',
    purpose: 'Does not disclose browsing history globally.',
  },
  {
    name: 'Hover',
    attribute: 'hover',
    label: 'Explore colour and surface roles',
    href: '/principles/color-system',
    treatment: 'Underlined, using --cn-color-link-hover.',
    purpose: 'Confirms the pointer target.',
  },
  {
    name: 'Active',
    attribute: 'active',
    label: 'Review the font system',
    href: '/base/fonts',
    treatment: 'Underlined, using --cn-color-link-active.',
    purpose: 'Confirms activation while it occurs.',
  },
  {
    name: 'Keyboard focus',
    attribute: 'focus-visible',
    label: 'Study surface elevation',
    href: '/base/surface',
    treatment:
      'A --cn-color-focus-ring outline with the current link treatment.',
    purpose: 'Marks keyboard position with shape as well as colour.',
  },
] as const;

if (!source.includes(LINK_SELECTOR)) {
  throw new Error('LinkStateTable could not find the native-link selector.');
}

const STATE_PSEUDOS = states
  .filter((state) => state.attribute)
  .map((state) => `:${state.attribute}`);

// Keep only the selectors that name a mapped pseudo-class, filtering inside
// each rule's selector list: the shipped file combines the resting selector
// and :visited in one list, so a block-level copy would re-inject a resting
// rule and defeat real interaction again.
// Splitting a selector list on bare commas would cut inside a functional
// pseudo-class — the link selector carries `:not(.button, .fab, .chip)` — so
// the split honours parenthesis depth.
const splitSelectorList = (list: string) => {
  const selectors = [];
  let depth = 0;
  let start = 0;
  for (let at = 0; at < list.length; at += 1) {
    const character = list[at];
    if (character === '(') depth += 1;
    else if (character === ')') depth -= 1;
    else if (character === ',' && depth === 0) {
      selectors.push(list.slice(start, at));
      start = at + 1;
    }
  }
  selectors.push(list.slice(start));
  return selectors.map((selector) => selector.trim());
};

const sourceWithoutComments = source.replace(/\/\*[\s\S]*?\*\//g, '');
const ruleBlocks = sourceWithoutComments.match(/[^{}]+\{[^{}]*\}/g) ?? [];
const stateRules = ruleBlocks.flatMap((block) => {
  const braceAt = block.indexOf('{');
  const selectors = splitSelectorList(block.slice(0, braceAt)).filter(
    (selector) => STATE_PSEUDOS.some((pseudo) => selector.includes(pseudo)),
  );
  if (selectors.length === 0) return [];
  return [`${selectors.join(',\n')} ${block.slice(braceAt)}`];
});

for (const pseudo of STATE_PSEUDOS) {
  if (!stateRules.some((rule) => rule.includes(pseudo))) {
    throw new Error(`LinkStateTable could not find a rule for ${pseudo}.`);
  }
}

let specimenSource = stateRules
  .join('\n')
  .replaceAll(LINK_SELECTOR, `.cn-link-state-specimen ${LINK_SELECTOR}`);
for (const pseudo of STATE_PSEUDOS) {
  specimenSource = specimenSource.replaceAll(
    pseudo,
    `[data-link-state="${pseudo.slice(1)}"]`,
  );
}

const MODES = ['light', 'dark'] as const;
---

<div class="scroll breakout">
  <table>
    <thead>
      <tr>
        <th scope="col">State</th>
        {MODES.map((mode) => <th scope="col">{mode}</th>)}
        <th scope="col">Treatment</th>
        <th scope="col">Purpose</th>
      </tr>
    </thead>
    <tbody>
      {states.map((state) => (
        <tr>
          <th scope="row">{state.name}</th>
          {MODES.map((mode) => (
            <td
              class="specimen cn-link-state-specimen"
              data-mode={mode}
              style={`color-scheme: ${mode};`}
            >
              <a href={state.href} data-link-state={state.attribute}>
                {state.label}
              </a>
            </td>
          ))}
          <td>{state.treatment}</td>
          <td>{state.purpose}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style is:inline set:html={specimenSource} />

<style>
  .scroll {
    overflow-x: auto;
  }

  .specimen {
    min-inline-size: 15rem;
    padding-inline: var(--cn-gap);
    color: var(--cn-color-text);
    background: var(--cn-color-background);
    white-space: nowrap;
  }
</style>
