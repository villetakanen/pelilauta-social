---
/**
 * ColorRamp — one family's tonal scale, as colour.
 *
 * v20's colour book renders every family this way. Steps are read from the
 * theme JSON, so a ramp cannot show a step that no longer exists.
 *
 * Reads tokens/themes/default.json: the writable source
 * scripts/generate-tokens.mjs renders to styles/chroma.css (ADR 0002). The
 * swatch itself still resolves through that generated `--chroma-*` custom
 * property, so a build-time drift between the two would show as a blank
 * swatch, not a silently wrong one.
 *
 * Book: apps/design/src/content/principles/color-system.mdx
 */
import type { ChromaTheme } from './tokenTable';

interface Props {
  /** The theme JSON, e.g. `tokens/themes/default.json`. */
  theme: ChromaTheme;
  /** Family name, e.g. `surface` — matches `--chroma-<family>-<step>`. */
  family: string;
  /** What the family is for. One line, shown beside the name. */
  intent?: string;
}

const { theme, family, intent } = Astro.props;

const definition = theme.families[family];

if (!definition) {
  throw new Error(
    `ColorRamp found no steps for family "${family}". The palette no longer declares it.`,
  );
}

// Object.keys of a plain object orders integer-like keys ascending, so this
// walks 0, 10, 20 … 100 regardless of the JSON's own key order.
const steps = Object.keys(definition.steps).map((step) => ({
  step,
  name: `--chroma-${family}-${step}`,
}));
---

<figure class="ramp">
  <figcaption>
    <strong>{family}</strong>{intent && <span> — {intent}</span>}
  </figcaption>
  <ol>
    {steps.map(({ step, name }) => (
      <li>
        <span class="swatch" style={`background: var(${name});`} title={name}></span>
        <span class="step">{step}</span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .ramp ol {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ramp li {
    flex: 1 1 3rem;
    text-align: center;
  }
  .swatch {
    display: block;
    block-size: 3rem;
    border: 1px solid var(--cn-border);
  }
  .step {
    display: block;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  figcaption {
    margin-block-end: 0.25rem;
  }
</style>
