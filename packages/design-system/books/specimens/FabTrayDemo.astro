---
/**
 * FabTrayDemo — a FAB tray inside a mock application shell.
 *
 * The tray pins to the composition that owns it, so a bounded box here shows the
 * same behaviour an application's dynamic-viewport shell shows. Two shells are
 * offered: `app`, a window-sized canvas rendered at full size and scaled down to
 * fit the book column, and `handheld`, a small canvas with persistent block-end
 * navigation that fits a Composition theme pane. Scaling is visual only — layout, and therefore the tray's container
 * query, resolves at the shell's stated size.
 *
 * The bar, the placeholder content and the rail are test rig standing in for the
 * application's own chrome. The tray and the FABs inside it are styled entirely by
 * styles/fab.css.
 *
 * Book: apps/design/src/content/base/links-actions-buttons.mdx
 */
import Icon from '../../components/Icon.svelte';

interface Props {
  /** Which mock shell to render. */
  shell: 'app' | 'handheld';
}

const { shell } = Astro.props;
---

<div class="frame" data-shell={shell}>
  <div class="shell">
    <header class="bar">
      <Icon noun="fox" />
      <span>Pelilauta</span>
    </header>

    <div class="content">
      <p class="rig-line" style="--rig-width: 70%"></p>
      <p class="rig-line" style="--rig-width: 95%"></p>
      <p class="rig-line" style="--rig-width: 88%"></p>
      <p class="rig-line" style="--rig-width: 40%"></p>
    </div>

    <nav class="fab-tray" aria-label="Quick actions">
      {shell === 'app' ? (
        <>
          <button type="button" class="fab secondary small" aria-label="Search">
            <Icon noun="search" />
          </button>
          <button type="button" class="fab cta">
            <Icon noun="add" />
            <span>Add a thread</span>
          </button>
        </>
      ) : (
        <>
          <button type="button" class="fab secondary small" aria-label="Search">
            <Icon noun="search" />
          </button>
          <button type="button" class="fab secondary" aria-label="Add a clock">
            <Icon noun="clock" />
          </button>
          <button type="button" class="fab cta">
            <Icon noun="add" />
            <span>Add a thread</span>
          </button>
        </>
      )}
    </nav>

    {shell === 'handheld' && (
      <nav class="rail" aria-hidden="true">
        <Icon noun="fox" />
        <Icon noun="card" />
        <Icon noun="search" />
      </nav>
    )}
  </div>
</div>

<style>
  /*
   * Test rig, not system values: the frame is the visible window onto the mock
   * shell, and the app shell is drawn at window size and scaled to fit it.
   */
  .frame {
    max-inline-size: 100%;
    overflow: hidden;
    color: var(--cn-color-text);
    background: var(--cn-color-background);
  }

  .shell {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    background: var(--cn-color-surface);
  }

  [data-shell='app'] {
    inline-size: 36rem;
    block-size: 20.25rem;
  }

  [data-shell='app'] .shell {
    inline-size: 80rem;
    block-size: 45rem;
    transform: scale(0.45);
    transform-origin: top left;
  }

  [data-shell='handheld'] {
    inline-size: 20rem;
    block-size: 30rem;
  }

  [data-shell='handheld'] .shell {
    inline-size: 20rem;
    block-size: 30rem;
    /* The rail occupies the block end, so the tray clears it. */
    --cn-block-end-chrome: 4rem;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--cn-gap);
    padding: var(--cn-gap);
    color: var(--cn-color-text-high);
    border-block-end: 1px solid var(--cn-color-border);
  }

  .content {
    display: grid;
    align-content: start;
    row-gap: var(--cn-line);
    padding: var(--cn-gap);
    overflow: hidden;
  }

  /* Placeholder prose: a block the reader will not try to read. */
  .rig-line {
    inline-size: var(--rig-width, 100%);
    block-size: var(--cn-grid);
    border-radius: var(--cn-border-radius-small);
    background: var(--cn-color-surface-2);
  }

  .rail {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    display: flex;
    align-items: center;
    justify-content: space-around;
    block-size: 4rem;
    background: var(--cn-color-surface-1);
    border-block-start: 1px solid var(--cn-color-border);
  }
</style>
