---
/**
 * Composition — a rendered combination of elements, framed so the reader can
 * tell the demonstration from the book around it.
 *
 * The slot content is set entirely by the design system: real elements, step
 * classes and tokens, nothing of this component's. The frame and caption are
 * the only styling here, and they read the system's tokens.
 */
interface Props {
  /** Names what the reader is looking at. Set in the caption step. */
  caption?: string;
  /**
   * Renders the slot in a container narrower than the small-screen breakpoint,
   * so the typography downshift can be seen operating. The width is test rig,
   * not a system value.
   */
  narrow?: boolean;
  /**
   * Renders the slot twice, side by side, one panel per colour scheme, so the
   * same content is evaluated in Light and Dark on one page.
   */
  themes?: boolean;
  /**
   * Stacks the colour-scheme panels instead of setting them side by side, so each
   * panel is offered the whole width. A component whose behaviour turns on its own
   * width cannot be shown in a half-width panel.
   */
  stack?: boolean;
  /**
   * Spans the width the Prose container was offered rather than its reading
   * measure. Pair it with `stack` where a demonstration needs more width than the
   * measure allows.
   */
  breakout?: boolean;
  /**
   * Paints the panel at a surface elevation, so a demonstration stands on the
   * level its subject is expected to sit at. Without it the panel keeps the
   * page's ground plane.
   */
  elevation?: 0 | 1 | 2 | 3 | 4;
}

const {
  caption,
  narrow = false,
  themes = false,
  stack = false,
  breakout = false,
  elevation,
} = Astro.props;
const level = elevation === undefined ? undefined : `elevation-${elevation}`;
const content = themes ? await Astro.slots.render('default') : undefined;
const MODES = ['light', 'dark'] as const;
---

<figure class:list={[{ breakout }]}>
  {
    themes ? (
      <div class:list={['modes', { stack }]}>
        {MODES.map((mode) => (
          <div
            class:list={['composition', 'themed', level ?? 'ground']}
            data-mode={mode}
            style={`color-scheme: ${mode};`}
            set:html={content}
          />
        ))}
      </div>
    ) : (
      <div class:list={['composition', { narrow }, level]}>
        <slot />
      </div>
    )
  }
  {caption && <figcaption class="text-label">{caption}</figcaption>}
</figure>

<style>
  figure {
    border: 1px solid var(--cn-color-border);
    border-radius: var(--cn-border-radius-medium);
  }

  .composition {
    display: grid;
    row-gap: var(--cn-line);
    padding: var(--cn-gap);
  }

  .narrow {
    container-type: inline-size;
    max-inline-size: 20rem;
  }

  .modes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  /* One panel per row, so each is offered the whole width rather than half of it. */
  .modes.stack {
    grid-template-columns: minmax(0, 1fr);
  }

  .themed {
    color: var(--cn-color-text);
  }

  /* The panel without an elevation keeps the page's ground plane. */
  .ground {
    background: var(--cn-color-background);
  }

  figcaption {
    padding: var(--cn-grid) var(--cn-gap);
    color: var(--cn-color-text-low);
    border-block-start: 1px solid var(--cn-color-border);
  }
</style>
