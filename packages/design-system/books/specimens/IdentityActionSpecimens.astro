---
/**
 * IdentityActionSpecimens — CnIdentityAction, one group for its one axis: mode.
 *
 * `CnIdentityAction` is imported directly, with no `client:` directive: it
 * needs no interactivity, and `Composition`'s `themes` mode re-renders the
 * slot's server HTML for each colour scheme, so an island would only
 * duplicate what the server already produced.
 *
 * Nothing here styles the target, the state surface, the Icon or the
 * identity mark; every rule comes from the component's own stylesheet. The
 * `.surface` and `.elevation-0` classes come from styles/surface.css, wrapped
 * around each rig.
 *
 * Book: apps/design/src/content/components/cn-identity-action.mdx
 */
import CnIdentityAction from '../../components/CnIdentityAction.svelte';

interface Props {
  /** Which axis to render. */
  group: 'modes';
  /** The presentation the wrapper declares via --cn-chrome-presentation. */
  presentation: 'compact' | 'labelled';
}

const { group, presentation } = Astro.props;

// Rig widths mirror ChromeActionSpecimens: a rail's width for compact, a
// tray's for labelled. See that specimen's header comment for why these are
// test rig values rather than design-system ones.
const RIG_INLINE_SIZE = {
  compact: 'calc(var(--cn-grid) * 10)', // rail: 80px
  labelled: 'calc(var(--cn-grid) * 42)', // tray: 336px
} as const;

// A deterministic image keeps the static book independent of network access.
const AVATAR_IMAGE =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Crect width='128' height='128' fill='%236f8f86'/%3E%3Ccircle cx='40' cy='42' r='28' fill='%23f0c987'/%3E%3Cpath d='M0 112 48 64l28 28 18-18 34 38v16H0Z' fill='%233e5f63'/%3E%3C/svg%3E";

const HREF_SIGNED_OUT = '/kirjaudu';
const HREF_SIGNED_IN = '/profiili';
const LABEL_SIGNED_OUT = 'Kirjaudu sisään';
const LABEL_SIGNED_IN = 'Oma profiili';

const ROWS = [
  {
    key: 'signed-out',
    heading: 'Signed out',
    signedIn: false,
    nick: '',
    src: '',
    current: false,
  },
  {
    key: 'signed-in',
    heading: 'Signed in, with an image',
    signedIn: true,
    nick: 'Aino Virtanen',
    src: AVATAR_IMAGE,
    current: false,
  },
  {
    key: 'signed-in-initials',
    heading: 'Signed in, no image',
    signedIn: true,
    nick: 'Aino Virtanen',
    src: '',
    current: false,
  },
  {
    key: 'signed-in-no-nick',
    heading: 'Signed in, no nick',
    signedIn: true,
    nick: '',
    src: '',
    current: false,
  },
  {
    key: 'current',
    heading: 'Current destination',
    signedIn: true,
    nick: 'Aino Virtanen',
    src: AVATAR_IMAGE,
    current: true,
  },
] as const;

// The control stands on the base surface only, per its spec.
const SURFACES = [
  { key: 'surface', label: 'Surface', class: 'surface elevation-0' },
] as const;
---

<div
  class="identity-action-specimen"
  data-group={group}
  data-presentation={presentation}
>
  {group === 'modes' && presentation === 'compact' && (
    // A rail-width rig fits the surface column beside a row header, so the
    // table stays the compact axis's natural shape.
    <table>
      <thead>
        <tr>
          <th scope="col">Row</th>
          {SURFACES.map((surface) => <th scope="col">{surface.label}</th>)}
        </tr>
      </thead>
      <tbody>
        {ROWS.map((row) => (
          <tr>
            <th scope="row">{row.heading}</th>
            {SURFACES.map((surface) => (
              <td>
                <div class={surface.class}>
                  <div
                    class="slot"
                    style={`--cn-chrome-presentation: ${presentation}; inline-size: ${RIG_INLINE_SIZE[presentation]};`}
                    data-specimen={`${row.key}-${surface.key}`}
                  >
                    <CnIdentityAction
                      href={row.signedIn ? HREF_SIGNED_IN : HREF_SIGNED_OUT}
                      label={row.signedIn ? LABEL_SIGNED_IN : LABEL_SIGNED_OUT}
                      signedIn={row.signedIn}
                      nick={row.nick}
                      src={row.src}
                      aria-current={row.current ? 'page' : undefined}
                    />
                  </div>
                </div>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  )}

  {group === 'modes' && presentation === 'labelled' && (
    // A tray-width rig is too wide for a table column, so the surface takes a
    // list instead.
    SURFACES.map((surface) => (
      <>
        <p class="text-label">{surface.label}</p>
        <dl class="state-list">
          {ROWS.map((row) => (
            <>
              <dt>{row.heading}</dt>
              <dd>
                <div class={surface.class}>
                  <div
                    class="slot"
                    style={`--cn-chrome-presentation: ${presentation}; inline-size: ${RIG_INLINE_SIZE[presentation]};`}
                    data-specimen={`${row.key}-${surface.key}`}
                  >
                    <CnIdentityAction
                      href={row.signedIn ? HREF_SIGNED_IN : HREF_SIGNED_OUT}
                      label={row.signedIn ? LABEL_SIGNED_IN : LABEL_SIGNED_OUT}
                      signedIn={row.signedIn}
                      nick={row.nick}
                      src={row.src}
                      aria-current={row.current ? 'page' : undefined}
                    />
                  </div>
                </div>
              </dd>
            </>
          ))}
        </dl>
      </>
    ))
  )}

</div>

<style>
  /*
   * A tray-width rig does not fit every viewport this book renders on;
   * scrolling the specimen keeps that mismatch local rather than widening
   * the panel, the figure, the breakout or the page. Same reasoning as
   * NotificationActionSpecimens.
   */
  .identity-action-specimen {
    overflow-x: auto;
  }

  table,
  .state-list {
    margin-inline: auto;
  }

  table {
    border-collapse: collapse;
  }

  .state-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: center;
    column-gap: var(--cn-gap);
    row-gap: var(--cn-grid);
    margin-block-end: var(--cn-line);
  }

  .state-list dt {
    text-align: end;
  }

  .state-list dd {
    margin: 0;
  }

  /*
   * The rig's own inline size is set inline, per presentation, from
   * RIG_INLINE_SIZE above, so a labelled target's own `inline-size: 100%`
   * always resolves against a real rail or tray width rather than a
   * percentage of the surrounding page.
   */
  .slot {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  th,
  td {
    padding: var(--cn-grid) var(--cn-gap);
    text-align: start;
    vertical-align: middle;
  }
</style>
