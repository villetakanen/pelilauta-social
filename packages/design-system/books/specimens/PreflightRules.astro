---
/**
 * Specimen: one group of the preflight, printed from the production stylesheet.
 *
 * A book must not repeat a stylesheet by hand, so the CSS a reader sees is sliced
 * out of styles/preflight.css at build time, using that file's own
 * `/* N. Title ---- *\/` group comments as boundaries. Adding a rule to a group
 * lists it here without anyone editing this file or the book.
 *
 * Spec: specs/design-system/preflight/spec.md
 */
import preflightSource from '@design-system/styles/preflight.css?raw';

interface Props {
  /** The group number as it appears in preflight.css. */
  group: string;
}

const { group } = Astro.props;

const sectionPattern = /\/\*\s*(\d)\.\s*([^-*]+?)\s*-+\s*\*\//g;
const sections = [...preflightSource.matchAll(sectionPattern)].map((match) => ({
  number: match[1],
  headingStart: match.index ?? 0,
  start: (match.index ?? 0) + match[0].length,
}));

const index = sections.findIndex((section) => section.number === group);
if (index === -1) {
  // A book naming a group that no longer exists is a defect, not an empty block.
  throw new Error(
    `preflight.css has no group ${group}. Groups present: ${sections
      .map((section) => section.number)
      .join(', ')}`,
  );
}

const end = sections[index + 1]?.headingStart ?? preflightSource.length;
const css = preflightSource
  .slice(sections[index].start, end)
  .replace(/\/\*[\s\S]*?\*\//g, '')
  .replace(/\n{2,}/g, '\n\n')
  .trim();
---

<pre><code>{css}</code></pre>
