---
/**
 * Specimen: named rules from the preflight, printed from the shipping stylesheet.
 *
 * A book must not repeat a stylesheet by hand, and it must not dump a whole file
 * either — a section shows the rules it is about. Selectors are matched against
 * styles/preflight.css at build time, so a rule cannot be described here and be
 * missing there.
 *
 * Spec: specs/design-system/preflight/spec.md
 */
import preflightSource from '@design-system/styles/preflight.css?raw';

interface Props {
  /** Selectors to print, exactly as written in the stylesheet, in its order. */
  rules: string[];
}

const { rules } = Astro.props;

const withoutComments = preflightSource.replace(/\/\*[\s\S]*?\*\//g, '');

/** Every rule in the stylesheet, as written, keyed by its normalised selector. */
const declared = new Map<string, string>();
for (const match of withoutComments.matchAll(/([^{}@;]+?)\s*\{([^}]*)\}/g)) {
  const selector = match[1].replace(/\s+/g, ' ').trim();
  const body = match[2].replace(/\n\s*/g, '\n  ').trimEnd();
  declared.set(selector, `${selector} {${body}\n}`);
}

const missing = rules.filter((selector) => !declared.has(selector));
if (missing.length > 0) {
  // A book naming a rule the stylesheet does not have is a defect, not a gap.
  throw new Error(
    `preflight.css has no rule for ${missing.join(', ')}. Declared: ${[
      ...declared.keys(),
    ].join(' | ')}`,
  );
}

const css = rules.map((selector) => declared.get(selector)).join('\n\n');
---

<pre><code>{css}</code></pre>
