---
/**
 * RoleTable — a semantic role shown in Light and Dark at once.
 *
 * `light-dark()` resolves against `color-scheme`, so a reader normally sees only
 * their own theme. Scoping `color-scheme` on each cell makes the browser resolve
 * both arms on one page. Cyan 4's colour book uses the same approach.
 *
 * The swatch itself resolves through the live cascade (`var(--cn-name)`); the
 * token graph here only confirms the role exists, from the writable role JSON
 * rather than a generated stylesheet.
 *
 * Book: apps/design/src/content/principles/color-system.mdx
 */
import type { ChromaTheme, RoleSource } from './tokenTable';
import { tokensFromJSON } from './color';

interface Props {
  /** The theme JSON, e.g. `tokens/themes/default.json`. */
  theme: ChromaTheme;
  /** Role sources the named roles are declared in. */
  roles: readonly RoleSource[];
  /** Roles to show, in reading order. */
  names: readonly string[];
  /** What each role is for, keyed by token name. */
  intents?: Record<string, string>;
  /** Names what the reader is looking at. */
  caption?: string;
}

const { theme, roles, names, intents = {}, caption } = Astro.props;

const tokens = tokensFromJSON(theme, ...roles);

const missing = names.filter((name) => !tokens.has(name));
if (missing.length > 0) {
  throw new Error(
    `RoleTable asked for roles the sources do not declare: ${missing.join(', ')}.`,
  );
}
---

<table>
  {caption && <caption>{caption}</caption>}
  <thead>
    <tr>
      <th scope="col">Role</th>
      <th scope="col">Light</th>
      <th scope="col">Dark</th>
      {Object.keys(intents).length > 0 && <th scope="col">Use for</th>}
    </tr>
  </thead>
  <tbody>
    {names.map((name) => (
      <tr>
        <th scope="row"><code>{name}</code></th>
        {(['light', 'dark'] as const).map((mode) => (
          <td>
            <span
              class="cell"
              data-mode={mode}
              data-role={name}
              style={`color-scheme: ${mode}; background: var(${name});`}
            ></span>
          </td>
        ))}
        {Object.keys(intents).length > 0 && <td>{intents[name] ?? ''}</td>}
      </tr>
    ))}
  </tbody>
</table>

<style>
  .cell {
    display: block;
    inline-size: 6rem;
    block-size: 2rem;
    border: 1px solid var(--cn-border);
    border-radius: var(--cn-border-radius-small);
  }
</style>
