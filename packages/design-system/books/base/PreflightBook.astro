---
/**
 * Preflight book.
 *
 * The rule list is parsed at build time from the production preflight.css, so the
 * book cannot describe a rule the stylesheet does not have, or miss one it does.
 * Group headings come from the section comments in that file.
 *
 * Spec: specs/design-system/preflight/spec.md
 */
import preflightSource from '@design-system/styles/preflight.css?raw';
import '@design-system/styles/ds.css';

interface Props {
  /** Book title, owned by the MDX entry's frontmatter. Rendered as the only h1. */
  title: string;
}

const { title } = Astro.props;

/**
 * The stylesheet's groups, read from its `/* N. Title ---- *\/` section comments.
 * Rules are attributed to the group they follow, so adding a rule to the
 * stylesheet lists it here without touching this file.
 */
const sectionPattern = /\/\*\s*(\d)\.\s*([^-*]+?)\s*-+\s*\*\//g;
const sections = [...preflightSource.matchAll(sectionPattern)].map((match) => ({
  number: match[1],
  title: match[2].trim(),
  /** Where the heading comment begins, which is where the previous group ends. */
  headingStart: match.index ?? 0,
  /** Where the group's rules begin. */
  start: (match.index ?? 0) + match[0].length,
}));

const withoutComments = (source: string) =>
  source.replace(/\/\*[\s\S]*?\*\//g, '');

/**
 * Every rule in a slice of the stylesheet, with its declarations.
 *
 * The selector pattern excludes `;` rather than anchoring on the previous rule's
 * closing brace: consuming that brace leaves the next rule with nothing to anchor
 * to, which silently dropped every second consecutive rule.
 */
function rules(slice: string) {
  const pattern = /([^{}@;]+?)\s*\{([^}]*)\}/g;
  return [...withoutComments(slice).matchAll(pattern)].map((match) => ({
    selector: match[1].replace(/\s+/g, ' ').trim(),
    declarations: match[2]
      .split(';')
      .map((line) => line.trim())
      .filter(Boolean),
  }));
}

const groups = sections.map((section, index) => {
  const end = sections[index + 1]?.headingStart ?? preflightSource.length;
  return { ...section, rules: rules(preflightSource.slice(section.start, end)) };
});

const ruleCount = groups.reduce((total, group) => total + group.rules.length, 0);
const declarationCount = groups.reduce(
  (total, group) =>
    total +
    group.rules.reduce((sum, rule) => sum + rule.declarations.length, 0),
  0,
);

/** What the preflight deliberately does not assert, and who owns it instead. */
const unowned = [
  {
    subject: 'Prose margins',
    owner: 'the type ramp',
    why: 'The rules that restore them are the ramp’s, so zeroing them here would be a rule waiting to be overridden.',
  },
  {
    subject: 'Image constraint',
    owner: 'whichever spec first owns the prose container',
    why: 'Cyan scopes max-width to images inside a section or article. Whether images are constrained globally or by their container is a container-level decision.',
  },
  {
    subject: 'Scrollbar appearance',
    owner: 'the themed-surface layer, unassigned',
    why: 'Cyan styles the standard and WebKit scrollbars from a width, a radius and three colour names. That is themed appearance rather than normalization — and nothing owns it, so the application loses scrollbar styling when Cyan goes.',
  },
];
---

<section class="hero">
  <p class="kicker">BASE / DOCUMENT / BOOK</p>
  <h1>{title}</h1>
  <p class="lede">
    What the design system asserts about a document before any component speaks:
    the browser inconsistencies it corrects, and the box and inheritance baseline
    every component may then rely on without restating it. If a rule here needed
    another stylesheet to win against it, it would be in the wrong file.
  </p>
  <dl class="facts">
    <div><dt>Groups</dt><dd>{groups.length}</dd></div>
    <div><dt>Rules</dt><dd>{ruleCount}</dd></div>
    <div><dt>Declarations</dt><dd>{declarationCount}</dd></div>
    <div><dt>Custom properties declared</dt><dd>0</dd></div>
  </dl>
</section>

<section aria-labelledby="origin-title">
  <div class="section-heading">
    <p>01 / WHERE IT COMES FROM</p>
    <h2 id="origin-title">A preflight both versions intended</h2>
    <p>
      v18's Cyan 4 and v20 both meant to ship a reset modelled on
      modern-normalize and Tailwind Preflight, and neither finished one. Cyan has
      a partial <code>core/preflight.css</code> with no form-control or media
      normalization. v20 has no preflight file at all: its rules sit inline in
      <code>AppShell.astro</code>'s global style block, mixed with the page grid
      and viewport height, which are a shell's business and not a reset's.
    </p>
    <p>
      So this is not a port. Cyan's file is the inventory of what the live
      application depends on; the model is where the rest comes from; and the
      shell layout stayed behind.
    </p>
  </div>
</section>

<section aria-labelledby="rules-title">
  <div class="section-heading">
    <p>02 / THE CLOSED SET</p>
    <h2 id="rules-title">Every rule, in five groups</h2>
    <p>
      The set is closed: a sixth concern changes the spec before it changes the
      stylesheet, and a test holds the literal selector list because prose cannot
      settle whether <code>optgroup</code> or a WebKit search pseudo-element is
      inside it. This table is parsed from the stylesheet, so it cannot drift.
    </p>
  </div>
  {groups.map((group) => (
    <div class="group">
      <h3>{group.number}. {group.title}</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Selector</th><th>Declares</th></tr>
          </thead>
          <tbody>
            {group.rules.map((rule) => (
              <tr>
                <td><code>{rule.selector}</code></td>
                <td>
                  <ul class="declarations">
                    {rule.declarations.map((declaration) => (
                      <li><code>{declaration}</code></li>
                    ))}
                  </ul>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))}
</section>

<section aria-labelledby="inherit-title">
  <div class="section-heading">
    <p>03 / WHAT YOU CAN ASSUME</p>
    <h2 id="inherit-title">A component need not restate these</h2>
    <p>
      The two groups worth knowing by heart, because they change what a component
      has to write.
    </p>
  </div>
  <ul class="assume">
    <li>
      <h3>Form controls inherit their type</h3>
      <p>
        A button, input, select or textarea takes the document's font family,
        size and line height, and carries no margin. Cyan compensated for the
        absence of this by setting font on each control from
        <code>--cn-*-ui</code> tokens declared in its <em>button</em> tokens — a
        UI font family living in button tokens is the symptom, not the design.
      </p>
    </li>
    <li>
      <h3>Lists are lists before they are prose</h3>
      <p>
        <code>ol</code>, <code>ul</code> and <code>menu</code> carry no markers,
        margin or padding, because the interface's navigations, menus and trays
        are built from them. Prose restores markers where prose lives.
      </p>
    </li>
  </ul>
</section>

<section aria-labelledby="unowned-title">
  <div class="section-heading">
    <p>04 / DELIBERATELY ABSENT</p>
    <h2 id="unowned-title">What this does not assert</h2>
    <p>
      Two of these exist only in Cyan today. Nothing fails when the terminal Cyan
      sweep deletes them, which is exactly why they are written down.
    </p>
  </div>
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th>Subject</th><th>Belongs to</th><th>Why not here</th></tr>
      </thead>
      <tbody>
        {unowned.map((entry) => (
          <tr>
            <td><strong>{entry.subject}</strong></td>
            <td>{entry.owner}</td>
            <td>{entry.why}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<section aria-labelledby="use-title">
  <div class="section-heading">
    <p>05 / USING IT</p>
    <h2 id="use-title">One import, any position</h2>
    <p>
      An application imports the design system's CSS entry point. Where in its
      shell it does so does not matter — the preflight states only what no other
      stylesheet has reason to state, so there is no order to get right.
    </p>
  </div>
  <pre><code>import '@design-system/styles/ds.css';</code></pre>
  <p class="note">
    <code>ds.css</code> composes the preflight and the tokens. When the type ramp
    moves out of Cyan it joins the same file, and neither application changes.
    <code>tokens.css</code> stays meaningful on its own for a consumer that wants
    tokens without a reset.
  </p>
</section>

<style>
  /* Book-specific only; the shared editorial vocabulary lives in docs.css. */
  .group {
    margin-block-end: 3rem;
  }

  .group h3 {
    margin-block-end: 0.75rem;
    color: var(--cn-text-high);
    font-size: 1.1rem;
  }

  .declarations {
    display: grid;
    gap: 0.15rem;
  }

  .declarations code {
    color: var(--cn-text-low);
  }

  .assume {
    display: grid;
    gap: 2rem;
    max-inline-size: 48rem;
  }

  .assume h3 {
    margin-block-end: 0.4rem;
    color: var(--cn-text-high);
    font-size: 1.05rem;
  }

  .assume p {
    margin: 0;
    color: var(--cn-text-low);
  }

  pre {
    padding: 1rem 1.25rem;
    border: 1px solid var(--cn-border);
    border-radius: var(--cn-border-radius);
    background: var(--cn-surface-1);
    overflow-x: auto;
  }

  .note {
    max-inline-size: 48rem;
    color: var(--cn-text-low);
  }
</style>
