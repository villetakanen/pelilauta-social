---
/**
 * CnTray — the trigger, the drawer, the scrim and the rail it collapses to.
 *
 * The tray holds the places a reader reaches from the page they are on. What
 * those are is the page's; this states the surface they stand on.
 *
 * Two checkboxes carry the request, one pair per side of the tablet
 * breakpoint, because HTML gives a checkbox one default and the two sides want
 * different ones: a phone rests closed, a desktop rests open. The window
 * displays one pair and removes the other, so `:checked` always means open and
 * opening never needs script.
 */
export interface Props {
  /** Names the control and the landmark. Both are the reader's only clue. */
  label: string;
  /**
   * Distinguishes this tray's controls from another document's. A page holds
   * one tray; a book page rendering a specimen states its own.
   */
  id?: string;
}

const { label, id = 'cn-tray' } = Astro.props;
const narrow = `${id}-narrow`;
const wide = `${id}-wide`;
---

<div class="cn-tray" data-cn-tray>
  {/*
    The checkbox is the control: focusable, named, and reporting its own
    checked state. It is hidden from view and from nothing else — `display:
    none` would take the only keyboard route into the tray with it.
  */}
  <input class="cn-tray-request narrow" type="checkbox" id={narrow} aria-label={label} />
  <input class="cn-tray-request wide" type="checkbox" id={wide} aria-label={label} checked />

  <label class="cn-tray-trigger narrow" for={narrow} aria-hidden="true">
    <span class="cn-tray-bars"></span>
  </label>
  <label class="cn-tray-trigger wide" for={wide} aria-hidden="true">
    <span class="cn-tray-bars"></span>
  </label>

  <nav class="cn-tray-drawer" aria-label={label}>
    <div class="cn-tray-entries">
      <slot />
    </div>
    {/* What the application keeps for the reader, flush to the block end. */}
    <div class="cn-tray-reader">
      <slot name="reader" />
    </div>
  </nav>

  {/* Only a covering tray has a scrim, and only the narrow pair ever covers. */}
  <label class="cn-tray-scrim" for={narrow} aria-hidden="true"></label>
</div>

<style>
  .cn-tray {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: var(--cn-z-tray);

    /* The tray declares its own presentation for the entries it holds. */
    --cn-chrome-presentation: labelled;
  }

  /*
   * Visually hidden but focusable, named and reporting its state. The trigger
   * beside it is decorative: it draws what the checkbox already says.
   */
  .cn-tray-request {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: 0;
    padding: 0;
    border: 0;
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }

  /* The trigger follows a chrome action's target, state surface and focus. */
  .cn-tray-trigger {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: calc(var(--cn-grid) * 7);
    block-size: calc(var(--cn-grid) * 7);
    margin: calc(var(--cn-grid) * 0.5);
    color: inherit;
    cursor: pointer;
  }
  .cn-tray-trigger::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    translate: -50% -50%;
    inline-size: calc(var(--cn-grid) * 6);
    block-size: calc(var(--cn-grid) * 6);
    border-radius: calc(var(--cn-grid) * 3);
    background-color: transparent;
    transition: background-color var(--cn-duration-ui) var(--cn-easing-ui);
  }
  .cn-tray-trigger:hover::before { background-color: var(--cn-hover); }
  .cn-tray-trigger:active::before { background-color: var(--cn-active); }

  /* The focus lands on the checkbox; the trigger is what shows it. */
  .cn-tray:has(.cn-tray-request.narrow:focus-visible) .cn-tray-trigger.narrow,
  .cn-tray:has(.cn-tray-request.wide:focus-visible) .cn-tray-trigger.wide {
    outline: 2px solid var(--cn-focus-ring);
    outline-offset: 2px;
  }

  /* Two bars, crossing while the tray is open. */
  .cn-tray-bars,
  .cn-tray-bars::before,
  .cn-tray-bars::after {
    display: block;
    inline-size: calc(var(--cn-grid) * 3);
    block-size: calc(var(--cn-grid) * 0.5);
    border-radius: calc(var(--cn-grid) * 0.25);
    background-color: currentColor;
  }
  .cn-tray-bars {
    position: relative;
    background-color: transparent;
  }
  .cn-tray-bars::before,
  .cn-tray-bars::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    transition:
      translate var(--cn-duration-ui) var(--cn-easing-ui),
      rotate var(--cn-duration-ui) var(--cn-easing-ui);
  }
  .cn-tray-bars::before { translate: 0 calc(var(--cn-grid) * -0.625); }
  .cn-tray-bars::after { translate: 0 calc(var(--cn-grid) * 0.625); }

  .cn-tray:has(.cn-tray-request.narrow:checked) .cn-tray-trigger.narrow .cn-tray-bars::before,
  .cn-tray:has(.cn-tray-request.wide:checked) .cn-tray-trigger.wide .cn-tray-bars::before {
    translate: 0 0;
    rotate: 45deg;
  }
  .cn-tray:has(.cn-tray-request.narrow:checked) .cn-tray-trigger.narrow .cn-tray-bars::after,
  .cn-tray:has(.cn-tray-request.wide:checked) .cn-tray-trigger.wide .cn-tray-bars::after {
    translate: 0 0;
    rotate: -45deg;
  }

  .cn-tray-drawer {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    inline-size: var(--cn-width-tray);
    max-inline-size: 100dvw;
    padding-block: calc(var(--cn-grid) * 0.5);
    overflow-y: auto;
    overflow-x: hidden;
    background-color: var(--cn-surface);
    transition:
      translate var(--cn-duration-ui) var(--cn-easing-ui),
      inline-size var(--cn-duration-ui) var(--cn-easing-ui);
  }
  .cn-tray-entries { flex: 1; }

  /* The reader's own, held at the block end however few entries there are. */
  .cn-tray-reader { margin-block-start: auto; }

  .cn-tray-scrim {
    position: fixed;
    inset: 0;
    z-index: var(--cn-z-scrim);
    background-color: var(--cn-scrim);
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
    transition: opacity var(--cn-duration-ui) var(--cn-easing-ui);
  }

  /*
   * A reader who asks for no motion gets the two states and nothing between.
   */
  @media (prefers-reduced-motion: reduce) {
    .cn-tray-drawer,
    .cn-tray-scrim,
    .cn-tray-bars::before,
    .cn-tray-bars::after {
      transition: none;
    }
  }

  /*
   * The small band holds no rail: the tray is absent, and its box is the
   * trigger alone, standing in the leading slot CnAppBar reserves for it.
   */
  @media (max-width: 38.75rem) {
    .cn-tray {
      inset-block-end: auto;
      inline-size: calc(var(--cn-grid) * 8);
    }
  }

  /* Narrower than the tablet breakpoint, the narrow pair is the control. */
  @media (max-width: 63.99rem) {
    .cn-tray-request.wide,
    .cn-tray-trigger.wide {
      display: none;
    }

    /* Asked for, the drawer leaves the strip and covers the page. */
    .cn-tray:has(.cn-tray-request.narrow:checked) .cn-tray-drawer {
      position: fixed;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: var(--cn-z-tray);
      inline-size: var(--cn-width-tray);
      background-color: var(--cn-surface-4);
      box-shadow: var(--cn-shadow-elevation-4);
    }
    .cn-tray:has(.cn-tray-request.narrow:checked) .cn-tray-scrim {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* The small band's resting tray is absent, in the tree as well as in view. */
  @media (max-width: 38.75rem) {
    .cn-tray:not(:has(.cn-tray-request.narrow:checked)) .cn-tray-drawer {
      display: none;
    }
  }

  /* The tablet band rests as a rail: the entries themselves, compact. */
  @media (min-width: 38.7501rem) and (max-width: 63.99rem) {
    .cn-tray {
      inline-size: var(--cn-width-rail);
      background-color: var(--cn-surface);
    }
    .cn-tray-drawer {
      inline-size: 100%;
      background-color: transparent;
    }
    .cn-tray:not(:has(.cn-tray-request.narrow:checked)) {
      --cn-chrome-presentation: compact;
    }
  }

  /*
   * The tablet breakpoint and wider: the wide pair is the control, the tray
   * stands beside the page in both states, and nothing covers anything.
   */
  @media (min-width: 64rem) {
    .cn-tray-request.narrow,
    .cn-tray-trigger.narrow,
    .cn-tray-scrim {
      display: none;
    }

    .cn-tray {
      inline-size: var(--cn-width-rail);
      background-color: var(--cn-surface);
      transition: inline-size var(--cn-duration-ui) var(--cn-easing-ui);
      --cn-chrome-presentation: compact;
    }
    /* The wide control rests checked, so a desktop page loads open. */
    .cn-tray:has(.cn-tray-request.wide:checked) {
      inline-size: var(--cn-width-tray);
      --cn-chrome-presentation: labelled;
    }

    .cn-tray-drawer {
      inline-size: 100%;
      background-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cn-tray {
      transition: none;
    }
  }
</style>
