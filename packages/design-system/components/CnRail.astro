---
/**
 * CnRail — the trigger, the drawer, the scrim, and the three boxes an
 * application fills.
 *
 * The rail holds the places a reader reaches from the page they are on. What
 * those are is the page's; this states the boxes they stand in.
 *
 * A box is spacing, not a surface: it paints nothing, and it takes no room
 * while it is empty. A header or a footer with nothing in it does not render,
 * so the arrangement stays legible while an application moves content between
 * them.
 *
 * Two checkboxes carry the request, one pair per side of the tablet
 * breakpoint, because HTML gives a checkbox one default and the two sides want
 * different ones: a phone rests closed, a desktop rests open. The chrome
 * container displays one pair and removes the other, so `:checked` always means
 * expanded and expanding never needs script.
 */
export interface Props {
  /** Names the control and the landmark. Both are the reader's only clue. */
  label: string;
  /**
   * Distinguishes this rail's controls from another document's. A page holds
   * one rail; a book page rendering a specimen states its own.
   */
  id?: string;
}

const { label, id = 'cn-rail' } = Astro.props;
const narrow = `${id}-narrow`;
const wide = `${id}-wide`;
const hasHeader = Astro.slots.has('header');
const hasFooter = Astro.slots.has('footer');
---

<div class="cn-rail" data-cn-rail>
  {/*
    The checkbox is the control: focusable, named, and reporting its own
    checked state. It is hidden from view and from nothing else — `display:
    none` would take the only keyboard route into the rail with it.
  */}
  <input class="cn-rail-request narrow" type="checkbox" id={narrow} aria-label={label} />
  <input class="cn-rail-request wide" type="checkbox" id={wide} aria-label={label} checked />

  <label class="cn-rail-trigger narrow" for={narrow} aria-hidden="true">
    <span class="cn-rail-bars">
      <span class="cn-rail-phase leaving"><span class="cn-rail-bar one"></span><span class="cn-rail-bar two"></span></span>
      <span class="cn-rail-phase returning"><span class="cn-rail-bar one"></span><span class="cn-rail-bar two"></span></span>
    </span>
  </label>
  <label class="cn-rail-trigger wide" for={wide} aria-hidden="true">
    <span class="cn-rail-bars">
      <span class="cn-rail-phase leaving"><span class="cn-rail-bar one"></span><span class="cn-rail-bar two"></span></span>
      <span class="cn-rail-phase returning"><span class="cn-rail-bar one"></span><span class="cn-rail-bar two"></span></span>
    </span>
  </label>

  <nav class="cn-rail-drawer" aria-label={label}>
    {hasHeader && (
      <div class="cn-rail-header">
        <slot name="header" />
      </div>
    )}

    <div class="cn-rail-body">
      <slot />
    </div>

    {hasFooter && (
      <div class="cn-rail-footer">
        <slot name="footer" />
      </div>
    )}
  </nav>

  {/* Only a covering rail has a scrim, and only the narrow pair ever covers. */}
  <label class="cn-rail-scrim" for={narrow} aria-hidden="true"></label>
</div>

{/*
  The only script the rail has. Opening and closing are a checkbox and CSS, and
  stay that way; a key press and a focus boundary are the two things CSS cannot
  express, and they are needed for exactly one state — the rail covering the
  page, over its scrim, with the document behind it out of sight.

  The narrow pair is that state's control. Where the chrome container displays
  the wide pair instead, nothing covers anything, so both behaviours stand down.
  The narrow trigger's own `display` reports which pair stands, rather than this
  script measuring anything and restating a breakpoint the stylesheet owns.
*/}
<script>
  const FOCUSABLE =
    'a[href], button:not(:disabled), input:not(:disabled), select, textarea, [tabindex]:not([tabindex="-1"])';

  for (const rail of document.querySelectorAll<HTMLElement>('[data-cn-rail]')) {
    const request = rail.querySelector<HTMLInputElement>('.cn-rail-request.narrow');
    const trigger = rail.querySelector<HTMLElement>('.cn-rail-trigger.narrow');
    const drawer = rail.querySelector<HTMLElement>('.cn-rail-drawer');
    if (!request || !trigger || !drawer) continue;

    const covering = () =>
      request.checked && getComputedStyle(trigger).display !== 'none';

    /*
     * The checkbox first: it is the control, it takes the focus the trigger
     * draws, and it is the boundary's own first stop, so `Escape` returns
     * there and a wrap from the end lands there.
     */
    const stops = () =>
      [request, ...drawer.querySelectorAll<HTMLElement>(FOCUSABLE)].filter(
        (node) => node.offsetParent !== null || node === request,
      );

    document.addEventListener('keydown', (event) => {
      if (!covering()) return;

      if (event.key === 'Escape') {
        request.checked = false;
        request.focus();
        return;
      }

      if (event.key !== 'Tab') return;

      const within = stops();
      if (!within.length) return;

      const first = within[0];
      const last = within[within.length - 1];
      const here = document.activeElement;

      if (!rail.contains(here)) {
        first.focus();
        event.preventDefault();
        return;
      }
      if (event.shiftKey && here === first) {
        last.focus();
        event.preventDefault();
      } else if (!event.shiftKey && here === last) {
        first.focus();
        event.preventDefault();
      }
    });
  }
</script>

<style>
  /*
   * A column, because the trigger stands above the drawer and takes its own
   * depth from it. The drawer taking the block size it is left with — rather
   * than the whole rail's — is what keeps the footer flush to the rail's end
   * rather than that far below it.
   */
  .cn-rail {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: var(--cn-z-rail);
    display: flex;
    flex-direction: column;
    /* The trigger stands outside the boxes, so it takes their inset itself
       rather than being centred — centring would move it as the rail widens,
       and it shares one axis with the entries below it. */
    align-items: flex-start;

    /* The rail declares its own presentation for the entries it holds. */
    --cn-chrome-presentation: labelled;
  }

  /*
   * Visually hidden but focusable, named and reporting its state. The trigger
   * beside it is decorative: it draws what the checkbox already says.
   */
  .cn-rail-request {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: 0;
    padding: 0;
    border: 0;
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }

  /* The trigger follows a chrome action's target, state surface and focus. */
  .cn-rail-trigger {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: calc(var(--cn-grid) * 7);
    block-size: calc(var(--cn-grid) * 7);
    margin: 0;
    color: inherit;
    cursor: pointer;
  }
  .cn-rail-trigger::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    translate: -50% -50%;
    inline-size: calc(var(--cn-grid) * 6);
    block-size: calc(var(--cn-grid) * 6);
    border-radius: calc(var(--cn-grid) * 3);
    background-color: transparent;
    transition: background-color var(--cn-duration-ui) var(--cn-easing-ui);
  }
  .cn-rail-trigger:hover::before { background-color: var(--cn-hover); }
  .cn-rail-trigger:active::before { background-color: var(--cn-active); }

  /* The focus lands on the checkbox; the trigger is what shows it. */
  .cn-rail:has(.cn-rail-request.narrow:focus-visible) .cn-rail-trigger.narrow,
  .cn-rail:has(.cn-rail-request.wide:focus-visible) .cn-rail-trigger.wide {
    outline: 2px solid var(--cn-focus-ring);
    outline-offset: 2px;
  }

  /*
   * The glyph: `=` while the rail is collapsed, `|<` while it is expanded.
   *
   * A quarter turn counter-clockwise carries the upper stroke to the start edge,
   * where it stands as the line, and the lower stroke to the end edge, where the
   * shape it has become — a V opening upward — reads as the chevron. Each stroke
   * is one clip path, so the chevron is one shape rather than two meeting.
   *
   * Turning the same way both times needs the resting pose to be `0deg` on the
   * way out and `-180deg` on the way back, and a transition has only two ends.
   * So the glyph is drawn twice: one copy turns `0deg` to `-90deg`, the other
   * `-90deg` to `-180deg`, and each is shown only while it is the one turning.
   * Every visible angle decreases, so every visible turn goes counter-clockwise.
   *
   * The copy that is not turning is not merely hidden — it takes the pose it
   * will start from next, at no duration, while nobody can see it. Nothing
   * shows, because a resting glyph is two identical strokes, so `-180deg` and
   * `0deg` are the same picture.
   *
   * Transitions, not animations, and that is what keeps this free of script: an
   * animation runs when its selector first matches, which includes the page
   * arriving, so a keyframed glyph turns once on every load. A transition runs
   * only when a value changes, and at load nothing has changed yet.
   */
  .cn-rail-bars {
    position: relative;
    inline-size: calc(var(--cn-grid) * 4);
    block-size: calc(var(--cn-grid) * 4);
  }
  .cn-rail-phase {
    position: absolute;
    inset: 0;
    transition: rotate var(--_motion) var(--cn-easing-ui);
  }
  .cn-rail-bar {
    position: absolute;
    inset: 0;
    background-color: currentColor;
    transition: clip-path var(--_motion) var(--cn-easing-ui);
  }
  .cn-rail-bar.one {
    clip-path: polygon(
      12.5% 28.125%, 50% 28.125%, 87.5% 28.125%,
      87.5% 40.625%, 50% 40.625%, 12.5% 40.625%
    );
  }
  .cn-rail-bar.two {
    clip-path: polygon(
      12.5% 59.375%, 50% 59.375%, 87.5% 59.375%,
      87.5% 71.875%, 50% 71.875%, 12.5% 71.875%
    );
  }

  /*
   * Collapsed. The returning copy holds the pose and the outgoing copy waits at
   * the one it will leave from.
   */
  .cn-rail-phase.leaving {
    opacity: 0;
    rotate: 0deg;
    --_motion: 0ms;
  }
  .cn-rail-phase.returning {
    opacity: 1;
    rotate: -180deg;
    --_motion: var(--cn-duration-ui);
  }

  /* Expanded. The two trade places, and the chevron is folded in both. */
  .cn-rail:has(.cn-rail-request.narrow:checked) .cn-rail-trigger.narrow .cn-rail-phase.leaving,
  .cn-rail:has(.cn-rail-request.wide:checked) .cn-rail-trigger.wide .cn-rail-phase.leaving {
    opacity: 1;
    rotate: -90deg;
    --_motion: var(--cn-duration-ui);
  }
  .cn-rail:has(.cn-rail-request.narrow:checked) .cn-rail-trigger.narrow .cn-rail-phase.returning,
  .cn-rail:has(.cn-rail-request.wide:checked) .cn-rail-trigger.wide .cn-rail-phase.returning {
    opacity: 0;
    rotate: -90deg;
    --_motion: 0ms;
  }
  .cn-rail:has(.cn-rail-request.narrow:checked) .cn-rail-trigger.narrow .cn-rail-bar.two,
  .cn-rail:has(.cn-rail-request.wide:checked) .cn-rail-trigger.wide .cn-rail-bar.two {
    clip-path: polygon(
      23.48% 79.64%, 50% 53.12%, 76.52% 79.64%,
      76.52% 97.32%, 50% 70.80%, 23.48% 97.32%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .cn-rail-phase,
    .cn-rail-bar {
      --_motion: 0ms;
    }
  }

  .cn-rail-drawer {
    display: flex;
    flex-direction: column;
    /* `min-block-size: 0` so a long entry list scrolls rather than growing. */
    flex: 1;
    min-block-size: 0;
    inline-size: var(--cn-width-rail-expanded);
    max-inline-size: 100dvw;
    overflow-y: auto;
    overflow-x: hidden;
    background-color: var(--cn-surface);
    transition:
      translate var(--cn-duration-ui) var(--cn-easing-ui),
      inline-size var(--cn-duration-ui) var(--cn-easing-ui);
  }

  /*
   * The three boxes. Each stacks what it holds on one axis: an entry is an
   * inline-level box, so a block container would let the entries flow and wrap
   * — packing a collapsed rail's entries into rows, and rewrapping them while
   * the rail travels between its two widths.
   */
  .cn-rail-header,
  .cn-rail-body,
  .cn-rail-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: none;
    /*
     * The box's inset, on every side, and the air the active background stands
     * in. It is what the collapsed rail leaves around a chrome action's target,
     * rather than `--cn-gap`: at the gap the target would not fit the rail's
     * width, and widening the rail to admit it would move the icons off the
     * line the application bar and the collapsed rail share.
     */
    padding: calc(
      (var(--cn-width-rail-collapsed) - var(--cn-grid) * 7) / 2
    );
  }

  /* The body takes what the other two leave, so the footer sits at the end. */
  .cn-rail-body { flex: 1; }

  /*
   * The trigger stands directly above the first box and already separates it
   * from what is above the rail, so that box adds no inset of its own there.
   * Two adjacent insets would stack, and one item in the column would sit at a
   * different pitch from every other.
   */
  .cn-rail-header,
  .cn-rail-header + .cn-rail-body,
  .cn-rail-body:first-child {
    padding-block-start: 0;
  }

  /*
   * The footer's line. A footer renders only when it holds something, so the
   * line marks a boundary that exists — and where the body is short, the line
   * lands where the reader is already looking rather than where the content
   * happened to stop.
   */
  .cn-rail-footer {
    border-block-start: 1px solid var(--cn-border);
  }

  .cn-rail-scrim {
    position: fixed;
    inset: 0;
    z-index: var(--cn-z-scrim);
    background-color: var(--cn-scrim);
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
    transition: opacity var(--cn-duration-ui) var(--cn-easing-ui);
  }

  /*
   * A reader who asks for no motion gets the two states and nothing between.
   */
  @media (prefers-reduced-motion: reduce) {
    .cn-rail-drawer,
    .cn-rail-scrim,
    .cn-rail-bars::before,
    .cn-rail-bars::after {
      transition: none;
    }
  }

  /*
   * The small band holds no rail: it is absent, and its box is the trigger
   * alone, standing in the leading slot CnAppBar reserves for it.
   */
  @container app-chrome (max-width: 38.75rem) {
    .cn-rail {
      inset-block-end: auto;
      inline-size: calc(var(--cn-grid) * 8);
    }
  }

  /* Narrower than the tablet breakpoint, the narrow pair is the control. */
  @container app-chrome (max-width: 63.99rem) {
    .cn-rail-request.wide,
    .cn-rail-trigger.wide {
      display: none;
    }

    /* Asked for, the drawer leaves the strip and covers the page. */
    .cn-rail:has(.cn-rail-request.narrow:checked) .cn-rail-drawer {
      position: fixed;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: var(--cn-z-rail);
      inline-size: var(--cn-width-rail-expanded);
      background-color: var(--cn-surface-4);
      box-shadow: var(--cn-shadow-elevation-4);
    }
    .cn-rail:has(.cn-rail-request.narrow:checked) .cn-rail-scrim {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* The small band's resting rail is absent, in the tree as well as in view. */
  @container app-chrome (max-width: 38.75rem) {
    .cn-rail:not(:has(.cn-rail-request.narrow:checked)) .cn-rail-drawer {
      display: none;
    }
  }

  /*
   * Where the rail stands beside the page, it begins where the application bar
   * ends. The bar spans the whole inline size and keeps the corner for the
   * page's identity, so the rail's trigger stands under that identity rather
   * than beside it, and the rail's own surface never reaches up behind it.
   */
  @container app-chrome (min-width: 38.7501rem) {
    /*
     * The rail begins where the bar's own target ends, not where its box does.
     * The bar is deeper than a chrome action's target, so a mark centred in it
     * carries half that difference as padding; starting the rail at the box
     * would count that padding twice and leave the trigger off the rhythm every
     * entry below it keeps.
     */
    .cn-rail {
      inset-block-start: calc(
        var(--cn-app-bar-height) -
        (var(--cn-app-bar-height) - var(--cn-grid) * 7) / 2
      );
    }

    /* The boxes' inset, so the trigger keeps the entries' axis at both widths. */
    .cn-rail-trigger {
      margin-inline-start: calc(
        (var(--cn-width-rail-collapsed) - var(--cn-grid) * 7) / 2
      );
    }
  }

  /* The tablet band rests collapsed: the entries themselves, compact. */
  @container app-chrome (min-width: 38.7501rem) and (max-width: 63.99rem) {
    .cn-rail {
      inline-size: var(--cn-width-rail-collapsed);
      background-color: var(--cn-surface);
    }
    .cn-rail-drawer {
      inline-size: 100%;
      background-color: transparent;
    }
    .cn-rail:not(:has(.cn-rail-request.narrow:checked)) {
      --cn-chrome-presentation: compact;
    }
  }

  /*
   * The tablet breakpoint and wider: the wide pair is the control, the rail
   * stands beside the page in both states, and nothing covers anything.
   */
  @container app-chrome (min-width: 64rem) {
    .cn-rail-request.narrow,
    .cn-rail-trigger.narrow,
    .cn-rail-scrim {
      display: none;
    }

    .cn-rail {
      inline-size: var(--cn-width-rail-collapsed);
      background-color: var(--cn-surface);
      transition: inline-size var(--cn-duration-ui) var(--cn-easing-ui);
      --cn-chrome-presentation: compact;
    }
    /* The wide control rests checked, so a desktop page loads expanded. */
    .cn-rail:has(.cn-rail-request.wide:checked) {
      inline-size: var(--cn-width-rail-expanded);
      --cn-chrome-presentation: labelled;
    }

    .cn-rail-drawer {
      inline-size: 100%;
      background-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cn-rail {
      transition: none;
    }
  }
</style>
