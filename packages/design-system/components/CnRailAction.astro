---
/**
 * CnRailAction — the chrome action that opens and closes the rail.
 *
 * Two checkbox toggles carry the reader's ask, one pair per side of the tablet
 * breakpoint, because HTML gives a checkbox one default and the two sides want
 * different ones: a phone rests closed, a desktop rests open. The `app-chrome`
 * container displays one pair and removes the other, so `:checked` always means
 * expanded and expanding never needs script.
 *
 * The toggle is the control: focusable, named, and reporting its own checked
 * state, which is what everything around it reads — the rail's width, the main
 * region's margin, the scrim's `for`. `.cn-rail-toggle.narrow`,
 * `.cn-rail-toggle.wide` and the `{id}-narrow`/`{id}-wide` ids are therefore
 * this component's published contract, not an internal detail.
 */
export interface Props {
  /** Names the control. It is the reader's only clue. */
  label: string;
  /**
   * Distinguishes this action's toggles from another document's. A page holds
   * one rail; a book page rendering a specimen states its own.
   */
  id?: string;
}

const { label, id = 'cn-rail' } = Astro.props;
const narrow = `${id}-narrow`;
const wide = `${id}-wide`;
---

<span class="cn-rail-action">
  {/*
    The toggle is hidden from view and from nothing else — `display: none`
    would take the only keyboard route into the rail with it.
  */}
  <input class="cn-rail-toggle narrow" type="checkbox" id={narrow} aria-label={label} />
  <input class="cn-rail-toggle wide" type="checkbox" id={wide} aria-label={label} checked />

  <label class="chrome-action cn-rail-trigger narrow" for={narrow} aria-hidden="true">
    <span class="cn-rail-bars">
      <span class="cn-rail-phase leaving"><span class="cn-rail-bar one"></span><span class="cn-rail-bar two"></span></span>
      <span class="cn-rail-phase returning"><span class="cn-rail-bar one"></span><span class="cn-rail-bar two"></span></span>
    </span>
  </label>
  <label class="chrome-action cn-rail-trigger wide" for={wide} aria-hidden="true">
    <span class="cn-rail-bars">
      <span class="cn-rail-phase leaving"><span class="cn-rail-bar one"></span><span class="cn-rail-bar two"></span></span>
      <span class="cn-rail-phase returning"><span class="cn-rail-bar one"></span><span class="cn-rail-bar two"></span></span>
    </span>
  </label>
</span>

<style>
  .cn-rail-action {
    display: inline-flex;
  }

  /*
   * Visually hidden but focusable, named and reporting its state. The trigger
   * beside it is decorative: it draws what the toggle already says.
   */
  .cn-rail-toggle {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: 0;
    padding: 0;
    border: 0;
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }

  /*
   * The trigger's target, state surface and transient states are the
   * `chrome-action` class it carries — `label.chrome-action[for]` in
   * `../styles/chrome-actions.css` — and nothing here.
   *
   * The focus outline is the one part the class cannot give it: the class
   * outlines the element that holds focus, and here that is the toggle. This
   * restates the class's outline on the trigger the focused toggle points at.
   */
  .cn-rail-action:has(.cn-rail-toggle.narrow:focus-visible) .cn-rail-trigger.narrow,
  .cn-rail-action:has(.cn-rail-toggle.wide:focus-visible) .cn-rail-trigger.wide {
    outline: 2px solid var(--cn-focus-ring);
    outline-offset: 2px;
  }

  /*
   * The glyph: `=` while the rail is collapsed, `|<` while it is expanded.
   *
   * A quarter turn counter-clockwise carries the upper stroke to the start edge,
   * where it stands as the line, and the lower stroke to the end edge, where the
   * shape it has become — a V opening upward — reads as the chevron. Each stroke
   * is one clip path, so the chevron is one shape rather than two meeting.
   *
   * Turning the same way both times needs the resting pose to be `0deg` on the
   * way out and `-180deg` on the way back, and a transition has only two ends.
   * So the glyph is drawn twice: one copy turns `0deg` to `-90deg`, the other
   * `-90deg` to `-180deg`, and each is shown only while it is the one turning.
   * Every visible angle decreases, so every visible turn goes counter-clockwise.
   *
   * The copy that is not turning is not merely hidden — it takes the pose it
   * will start from next, at no duration, while nobody can see it. Nothing
   * shows, because a resting glyph is two identical strokes, so `-180deg` and
   * `0deg` are the same picture.
   *
   * Transitions, not animations, and that is what keeps this free of script: an
   * animation runs when its selector first matches, which includes the page
   * arriving, so a keyframed glyph turns once on every load. A transition runs
   * only when a value changes, and at load nothing has changed yet.
   */
  .cn-rail-bars {
    position: relative;
    inline-size: calc(var(--cn-grid) * 4);
    block-size: calc(var(--cn-grid) * 4);
  }
  .cn-rail-phase {
    position: absolute;
    inset: 0;
    transition: rotate var(--_motion) var(--cn-easing-ui);
  }
  .cn-rail-bar {
    position: absolute;
    inset: 0;
    background-color: currentColor;
    transition: clip-path var(--_motion) var(--cn-easing-ui);
  }
  .cn-rail-bar.one {
    clip-path: polygon(
      12.5% 28.125%, 50% 28.125%, 87.5% 28.125%,
      87.5% 40.625%, 50% 40.625%, 12.5% 40.625%
    );
  }
  .cn-rail-bar.two {
    clip-path: polygon(
      12.5% 59.375%, 50% 59.375%, 87.5% 59.375%,
      87.5% 71.875%, 50% 71.875%, 12.5% 71.875%
    );
  }

  /*
   * Collapsed. The returning copy holds the pose and the outgoing copy waits at
   * the one it will leave from.
   */
  .cn-rail-phase.leaving {
    opacity: 0;
    rotate: 0deg;
    --_motion: 0ms;
  }
  .cn-rail-phase.returning {
    opacity: 1;
    rotate: -180deg;
    --_motion: var(--cn-duration-ui);
  }

  /* Expanded. The two trade places, and the chevron is folded in both. */
  .cn-rail-action:has(.cn-rail-toggle.narrow:checked) .cn-rail-trigger.narrow .cn-rail-phase.leaving,
  .cn-rail-action:has(.cn-rail-toggle.wide:checked) .cn-rail-trigger.wide .cn-rail-phase.leaving {
    opacity: 1;
    rotate: -90deg;
    --_motion: var(--cn-duration-ui);
  }
  .cn-rail-action:has(.cn-rail-toggle.narrow:checked) .cn-rail-trigger.narrow .cn-rail-phase.returning,
  .cn-rail-action:has(.cn-rail-toggle.wide:checked) .cn-rail-trigger.wide .cn-rail-phase.returning {
    opacity: 0;
    rotate: -90deg;
    --_motion: 0ms;
  }
  .cn-rail-action:has(.cn-rail-toggle.narrow:checked) .cn-rail-trigger.narrow .cn-rail-bar.two,
  .cn-rail-action:has(.cn-rail-toggle.wide:checked) .cn-rail-trigger.wide .cn-rail-bar.two {
    clip-path: polygon(
      23.48% 79.64%, 50% 53.12%, 76.52% 79.64%,
      76.52% 97.32%, 50% 70.80%, 23.48% 97.32%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .cn-rail-phase,
    .cn-rail-bar {
      --_motion: 0ms;
    }
  }

  /* Narrower than the tablet breakpoint, the narrow pair is the control. */
  @container app-chrome (max-width: 63.99rem) {
    .cn-rail-toggle.wide,
    .cn-rail-trigger.wide {
      display: none;
    }
  }

  /* The tablet breakpoint and wider, the wide pair is. */
  @container app-chrome (min-width: 64rem) {
    .cn-rail-toggle.narrow,
    .cn-rail-trigger.narrow {
      display: none;
    }
  }
</style>
